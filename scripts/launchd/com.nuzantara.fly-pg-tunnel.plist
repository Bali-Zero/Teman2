<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nuzantara.fly-pg-tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/fly</string>
        <string>proxy</string>
        <string>15432:5432</string>
        <string>-a</string>
        <string>nuzantara-postgres</string>
        <string>--bind-addr</string>
        <string>127.0.0.1</string>
    </array>

    <!-- Restart automatically if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Wait 10s between restarts to avoid rapid crash loops -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Run at login and stay running -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/antonellosiano/Projects/nuzantara/logs/fly-pg-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/antonellosiano/Projects/nuzantara/logs/fly-pg-tunnel.log</string>

    <!-- fly CLI reads token from ~/.fly/config.yml automatically -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/antonellosiano</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
