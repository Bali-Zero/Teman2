<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.balizero.profile-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_DIR__/profile-monitor</string>
        <string>__EMPLOYEE__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/balizero-profile-monitor.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/balizero-profile-monitor.error.log</string>
</dict>
</plist>
