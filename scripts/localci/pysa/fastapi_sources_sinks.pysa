# Sources: parameters of FastAPI route handlers (mirrors CodeQL's FastAPI RemoteFlowSource model).
# Dependency-injected / framework parameters are excluded by name and by annotation.
# Sinks: whatever a route handler returns is serialised to the client (stack-trace exposure rule 6302).

# Starlette request object: the attributes CodeQL models as remote flow sources.
@property
def starlette.requests.HTTPConnection.query_params(self) -> TaintSource[UserControlled]: ...
@property
def starlette.requests.HTTPConnection.path_params(self) -> TaintSource[UserControlled]: ...
@property
def starlette.requests.HTTPConnection.headers(self) -> TaintSource[UserControlled]: ...
@property
def starlette.requests.HTTPConnection.cookies(self) -> TaintSource[UserControlled]: ...
@property
def starlette.requests.HTTPConnection.url(self) -> TaintSource[UserControlled]: ...
async def starlette.requests.Request.json(self) -> TaintSource[UserControlled]: ...
async def starlette.requests.Request.body(self) -> TaintSource[UserControlled]: ...
async def starlette.requests.Request.form(self) -> TaintSource[UserControlled]: ...
async def starlette.websockets.WebSocket.receive_text(self) -> TaintSource[UserControlled]: ...
async def starlette.websockets.WebSocket.receive_json(self) -> TaintSource[UserControlled]: ...

# Responses and exceptions reaching the client.
def fastapi.exceptions.HTTPException.__init__(self, detail: TaintSink[ReturnedToUser]): ...
def starlette.exceptions.HTTPException.__init__(self, detail: TaintSink[ReturnedToUser]): ...
def starlette.responses.Response.__init__(self, content: TaintSink[ReturnedToUser]): ...
def starlette.responses.JSONResponse.__init__(self, content: TaintSink[ReturnedToUser]): ...
def starlette.responses.RedirectResponse.__init__(self, url: TaintSink[Redirect]): ...

# Exception text sources beyond BaseException.__str__ (already modelled upstream).
def traceback.format_exc() -> TaintSource[Exception]: ...
def traceback.format_exception() -> TaintSource[Exception]: ...

# SSRF sinks for the HTTP clients this backend uses (upstream models cover `requests` only).
def httpx._api.get(url: TaintSink[HTTPClientRequest_URI]): ...
def httpx._api.post(url: TaintSink[HTTPClientRequest_URI]): ...
def httpx._api.request(url: TaintSink[HTTPClientRequest_URI]): ...
def httpx._client.Client.get(self, url: TaintSink[HTTPClientRequest_URI]): ...
def httpx._client.Client.post(self, url: TaintSink[HTTPClientRequest_URI]): ...
def httpx._client.AsyncClient.get(self, url: TaintSink[HTTPClientRequest_URI]): ...
def httpx._client.AsyncClient.post(self, url: TaintSink[HTTPClientRequest_URI]): ...
def httpx._client.AsyncClient.request(self, url: TaintSink[HTTPClientRequest_URI]): ...
def aiohttp.client.ClientSession.get(self, url: TaintSink[HTTPClientRequest_URI]): ...
def aiohttp.client.ClientSession.post(self, url: TaintSink[HTTPClientRequest_URI]): ...

# Path-injection sinks CodeQL reports that the upstream filesystem models do not name.
def genericpath.exists(path: TaintSink[FileSystem_Other]): ...
def os.stat(path: TaintSink[FileSystem_Other]): ...
def pathlib.Path.exists(self: TaintSink[FileSystem_Other]): ...
def pathlib.Path.stat(self: TaintSink[FileSystem_Other]): ...
def pathlib.Path.resolve(self: TaintSink[FileSystem_Other]): ...
