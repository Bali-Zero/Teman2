{
  "rule": "PMA_CLOSED_NO_BESAR_SCALE",
  "ruled": {
    "by": "owner (Zero)",
    "date": "2026-09-14",
    "verbatim": "100% non PMA i codici che non hanno skala besar",
    "meaning": "A KBLI 2025 code whose OSS scale matrix (per_skala) is non-empty and names no Usaha Besar scale cannot be operated by a PT PMA: foreign ownership 0%."
  },
  "citations": [
    {
      "instrument": "Peraturan Presiden No. 10 Tahun 2021 tentang Bidang Usaha Penanaman Modal (as amended by Perpres 49/2021)",
      "article": "Pasal 7 ayat (1)",
      "reading": "a foreign investor may carry on business only as an Usaha Besar"
    },
    {
      "instrument": "Peraturan Menteri Investasi dan Hilirisasi/Kepala BKPM No. 5 Tahun 2025",
      "article": "Pasal 26 ayat (1)",
      "quote": "Badan usaha sebagaimana dimaksud dalam Pasal 23 ayat (9) dan ayat (10) yang dikategorikan PMA merupakan usaha besar dan wajib mengikuti ketentuan minimum nilai investasi, kecuali ditentukan lain berdasarkan peraturan perundang-undangan.",
      "enacted": "2025-10-01",
      "url": "https://www.peraturan.go.id/files/peraturan-bkpm-no-5-tahun-2025.pdf",
      "retrieved": "2026-09-14",
      "pdf_sha256": "7ebd06ef03011417e11b2d4be004bf36af4460fbf100acb5b04256af09ffecbf"
    }
  ],
  "source_vintage": "2025-10-01",
  "selector": "per_skala non-empty AND no entry whose skala_usaha LIST contains 'Besar' (perpres_body_default_relation.besar_state == 'absent')",
  "out_of_scope": {
    "unobserved_empty_per_skala": 217,
    "why": "an empty per_skala is a gap in our OSS snapshot, not an observed absence of Besar; the rule never fires on it"
  },
