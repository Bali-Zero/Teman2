// GUILT: an alias ADDED to `hosts` — a well-formed, foreign IPv4, so both clauses of the pin are
// satisfied — then used as a SOURCE. Additive tolerance exists so the enrolment runbook's seventh
// entry does not redden the guard; it is not a licence for a new machine to originate traffic.
// Measured before the cure: every port except pro:443 was green this way, OpenSSH on Pro included.
// SHELL-ROUTE: /term -> 127.0.0.1:7681 is ttyd -W zsh.
// ============================================================================
{
  "hosts": {
    "pro":              "100.107.22.111",
    "mini":             "100.93.236.6",
    "m5":               "100.110.186.116",
    "iphone-14":        "100.113.83.92",
    "iphone175":        "100.77.16.7",
    "apple-vision-pro": "100.97.28.18",
    "rogue":            "100.64.13.37"
  },
  "acls": [
    {"action": "accept", "proto": "tcp", "src": ["rogue"], "dst": ["mini:6379"]}
  ],
  "ssh": [],
  "tests": [
    {"src": "rogue", "accept": ["mini:6379"]},
    {"src": "tag:team-device", "deny": ["pro:443"]}
  ]
}
