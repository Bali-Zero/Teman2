// GUILT (grader round 1, HIGH): `autogroup:tagged` contains every tagged node, so it contains
// the team laptop — while looking nothing like `tag:team-device`.
// SHELL-ROUTE: /term -> 127.0.0.1:7681 is ttyd -W zsh.
{
  "hosts": {"pro": "100.107.22.111", "m5": "100.110.186.116", "mini": "100.93.236.6"},
  "tagOwners": {"tag:team-device": ["autogroup:admin"]},
  "acls": [
    {"action": "accept", "proto": "tcp", "src": ["autogroup:tagged"], "dst": ["pro:22"]}
  ],
  "ssh": [],
  "tests": [{"src": "tag:team-device", "deny": ["pro:443"]}]
}
