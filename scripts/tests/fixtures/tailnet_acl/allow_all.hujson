// GUILT: the factory default, restated. Every node reaches every port on every node — which is
// how the tailnet-wide unauthenticated ttyd shell (SHELL-ROUTE: /term -> 127.0.0.1:7681, ttyd -W)
// became reachable from any joined device in the first place.
{
  "hosts": {"pro": "100.107.22.111"},
  "tagOwners": {"tag:team": ["autogroup:admin"]},
  "acls": [
    {"action": "accept", "src": ["*"], "dst": ["*:*"]}
  ],
  "ssh": [],
  "tests": [{"src": "tag:team", "deny": ["pro:443"]}]
}
