// GUILT: a /32 CIDR alias for Pro's OWN address. It is the shell host by any operational
// reading, but `100.107.22.111/32` is not the string `100.107.22.111`, so
// canonicalisation filed it under a different node identity and the shell-port allowlist
// never fired.
// SHELL-ROUTE: /term -> 127.0.0.1:7681 is ttyd -W zsh.
{
  "hosts": {
    "pro":              "100.107.22.111",
    "mini":             "100.93.236.6",
    "m5":               "100.110.186.116",
    "iphone-14":        "100.113.83.92",
    "iphone175":        "100.77.16.7",
    "apple-vision-pro": "100.97.28.18",
    "pro-cidr":         "100.107.22.111/32"
  },
  "acls": [
    {"action": "accept", "proto": "tcp", "src": ["mini"], "dst": ["pro-cidr:443"]}
  ],
  "ssh": [],
  "tests": [
    {"src": "mini", "accept": ["pro-cidr:443"]},
    {"src": "tag:team-device", "deny": ["pro:443"]}
  ]
}
