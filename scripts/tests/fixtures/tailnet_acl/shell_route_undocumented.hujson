// GUILT: a structurally correct policy that never says which port is load-bearing. The next
// reader sees a tidy pro:443 grant and has no way to know it carries a writable shell on the
// machine holding the raw PII, so the first "just let the laptop see the deck" request widens it.
{
  "hosts": {"pro": "100.107.22.111", "m5": "100.110.186.116"},
  "tagOwners": {"tag:team": ["autogroup:admin"]},
  "acls": [
    {"action": "accept", "src": ["m5"], "dst": ["pro:443"]}
  ],
  "ssh": [],
  "tests": [{"src": "tag:team", "deny": ["pro:443"]}]
}
