  "tagOwners": {"tag:team-device": ["autogroup:admin"]},
  "acls": [
    {"action": "accept", "src": ["m5"], "dst": ["pro:22"]}
  ],
  "ssh": [],
  "tests": [{"src": "tag:team-device", "deny": ["pro:443"]}]
}
