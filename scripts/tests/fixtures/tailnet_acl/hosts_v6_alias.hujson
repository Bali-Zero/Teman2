// GUILT: an IPv6 alias for Pro. The shell anchor is a single IPv4 literal, so this
// spelling of the same machine is `a node` that the guard cannot recognise AS the shell
// host — and the destination therefore never reaches the shell-port allowlist at all.
// SHELL-ROUTE: /term -> 127.0.0.1:7681 is ttyd -W zsh.
{
  "hosts": {
    "pro":              "100.107.22.111",
    "mini":             "100.93.236.6",
    "m5":               "100.110.186.116",
    "iphone-14":        "100.113.83.92",
    "iphone175":        "100.77.16.7",
    "apple-vision-pro": "100.97.28.18",
    "pro-v6":           "fd7a:115c:a1ce:1::1"
  },
  "acls": [
    {"action": "accept", "proto": "tcp", "src": ["mini"], "dst": ["pro-v6:443"]}
  ],
  "ssh": [],
  "tests": [
    {"src": "mini", "accept": ["pro-v6:443"]},
    {"src": "tag:team-device", "deny": ["pro:443"]}
  ]
}
