// GUILT: the `m5` alias re-pointed at a foreign address. Every value is still a bare
// IPv4 and every other check stays green — the allowlist of which nodes may open the
// shell port resolves THROUGH `hosts`, so the foreign machine inherits pro:443 while the
// real M5 loses all of its access. Caught only by the whole-table pin, which is why that
// clause of the assertion (pinned aliases are immovable) exists — the bare-IPv4 clause cannot
// see this one at all.
// SHELL-ROUTE: /term -> 127.0.0.1:7681 is ttyd -W zsh.
{
  "hosts": {
    "pro":              "100.107.22.111",
    "mini":             "100.93.236.6",
    "m5":               "100.64.13.37",
    "iphone-14":        "100.113.83.92",
    "iphone175":        "100.77.16.7",
    "apple-vision-pro": "100.97.28.18"
  },
  "acls": [
    {"action": "accept", "proto": "tcp", "src": ["m5"], "dst": ["pro:443"]}
  ],
  "ssh": [],
  "tests": [
    {"src": "m5", "accept": ["pro:443"]},
    {"src": "tag:team-device", "deny": ["pro:443"]}
  ]
}
