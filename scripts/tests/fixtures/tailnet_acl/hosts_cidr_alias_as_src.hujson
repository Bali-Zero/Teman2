// GUILT: a CIDR laundered through `hosts` and used as a SOURCE. Tailscale's `hosts`
// accepts a CIDR, so this promotes a whole address range to `a node` and hands it Mini's
// sshd. The shell-port variant of this trick was already caught; this indirection was
// not, because `_is_node` believed whatever `hosts` declared.
// SHELL-ROUTE: /term -> 127.0.0.1:7681 is ttyd -W zsh.
{
  "hosts": {
    "pro":              "100.107.22.111",
    "mini":             "100.93.236.6",
    "m5":               "100.110.186.116",
    "iphone-14":        "100.113.83.92",
    "iphone175":        "100.77.16.7",
    "apple-vision-pro": "100.97.28.18",
    "tailnet":          "100.64.0.0/10"
  },
  "acls": [
    {"action": "accept", "proto": "tcp", "src": ["tailnet"], "dst": ["mini:22"]}
  ],
  "ssh": [],
  "tests": [
    {"src": "tailnet", "accept": ["mini:22"]},
    {"src": "tag:team-device", "deny": ["pro:443"]}
  ]
}
