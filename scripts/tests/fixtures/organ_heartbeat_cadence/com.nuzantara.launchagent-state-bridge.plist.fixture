<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/nuzantara</string>
		<key>PATH</key>
		<string>/Users/nuzantara/.pyenv/versions/3.11.11/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
	</dict>
	<key>Label</key>
	<string>com.nuzantara.launchagent-state-bridge</string>
	<key>Program</key>
	<string>/Users/nuzantara/.pyenv/versions/3.11.11/bin/python3</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nuzantara/.pyenv/versions/3.11.11/bin/python3</string>
		<string>/Users/nuzantara/scripts/launchagent-state-bridge.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/nuzantara/logs/launchagent-state-bridge.error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/nuzantara/logs/launchagent-state-bridge.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>