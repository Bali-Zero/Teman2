{
  "_doc": [
    "genes.json — the ORGAN GENOME: single source of truth for the genes every",
    "launchd/cron organ must inherit at birth (research/operations/2026-07-06-dna-self-healing-genome.md).",
    "Consumed by: check_organ_conformance.py (CI gate), scripts/organ_birth.py (generator).",
    "",
    "genes: definitions only — detection logic lives in the checker, templates in the",
    "generator; this file names the contract so gate and generator can never diverge",
    "on WHICH genes exist (a divergence is a failing test, test_organ_conformance.py).",
    "",
    "grandfathered: plist path -> list of genes known-missing at gate birth (2026-07-06).",
    "Report-only: a PR touching a grandfathered plist FAILS only on REGRESSION",
    "(missing genes beyond the recorded set). A plist NOT listed here is NEW and",
    "must carry every applicable gene. Regenerate after curing an organ:",
    "  python3 infra/organ-conformance/check_organ_conformance.py --update-baseline",
    "(shrinking the baseline is the cure metric; growing it requires a PR reviewer's eyes)."
  ],
  "version": 1,
  "genes": {
    "G1_registry": {
      "name": "registry entry",
      "check": "plist Label appears in apps/organism/organism/organs_registry.yaml",
      "why": "an organ absent from the registry is dark tissue: no sentinel verdict, no healer receptor, no recovery_action"
    },
    "G2_heartbeat": {
      "name": "heartbeat sidecar",
      "check": "wrapper calls organism_heartbeat or writes ~/.organism/last_seen/<id>.json on success AND failure paths",
      "why": "Esiste≠Armato (#2): liveness must be proven by the organ itself, every run"
    },
    "G3_declared_pair": {
      "name": "declared HOME pair",
      "check": "plist payload under $HOME requires a live<->repo pair in infra/home-fork/declared-pairs.json",
      "why": "HOME-fork drift (#1): an undeclared live copy diverges silently from canon"
    },
    "G4_node_guard": {
      "name": "node guard",
      "check": "generator-emitted wrappers exit 0 with heartbeat status=disabled note=wrong-node when hostname != assigned node (advisory in gate: not statically detectable on legacy wrappers)",
      "why": "active-active split-brain (#10): a singleton run on two machines corrupts shared state; the guard must stay VISIBLE (heartbeat), never a silent exit"
    },
    "G5_kill_switch": {
      "name": "kill switch",
      "check": "wrapper honors <SCOPE>_ENABLED=false AND writes a final heartbeat status=disabled before exiting",
      "why": "operator must be able to stop any organ without uninstalling it; the disabled heartbeat keeps the healer from resurrecting an intentionally-stopped organ (panel finding 2026-07-06)"
    },
    "G6_spawn_hardened": {
      "name": "hardened headless claude spawn",
      "check": "wrapper invoking `claude -p` must carry --strict-mcp-config, </dev/null stdin, and a TCC strategy (ssh trampoline or SSH_CONNECTION assertion)",
      "why": "the 4 headless gotchas (bypass-acceptance, folder-trust, per-binary TCC/W84, MCP-init hang) each present as a silent 0-CPU hang"
    },
    "G7_ledger": {
      "name": "PENDING-ARMS line at birth",
      "check": "procedural (generator emits the line; pending_arms_report.py --strict enforces >48h): not statically checkable on a plist",
      "why": "built is not armed (W81): the arming debt must be visible from minute zero"
    },
    "G8_keepalive_sane": {
      "name": "KeepAlive matches payload nature",
      "check": "delegated to scripts/lint_plist_keepalive.py (FAIL-class findings only)",
      "why": "daemon-vs-cron misconfig (#7): KeepAlive=true on a one-shot payload is a restart storm"
    },
    "G9_fail_visible": {
      "name": "fail-visible wrapper",
      "check": "bash wrappers declare `set -u` (or -eu); logging function present",
      "why": "swallowed errors are how green lies (#2); unset-var typos must crash, not expand empty"
    },
    "G10_single_instance": {
      "name": "single instance / idempotent restart",
      "check": "wrapper uses a pidfile (+ liveness probe + trap cleanup) or flock; mandatory for llm-cron, advisory otherwise",
      "why": "a healer/cron restarted over a live predecessor corrupts state (panel finding 2026-07-06: restart without idempotency is a cure that wounds)"
    }
  },
  "scan_roots": ["infra", "apps", "scripts"],
