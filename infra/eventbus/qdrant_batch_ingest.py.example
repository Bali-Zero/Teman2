#!/usr/bin/env python3
"""Direct Qdrant batch ingest v2 — per-file timeout + immediate log flush."""
import asyncio
import json
import os
import sys
import time
from datetime import datetime
from dotenv import load_dotenv

ENV = "/Users/nuzantara/Desktop/nuzantara/apps/backend-rag/.env"
load_dotenv(ENV, override=True)
os.environ.setdefault(
    "DATABASE_URL",
    "postgresql://backend_rag_v2:2zEjit43IF6gNUV@localhost:15432/nuzantara_rag?sslmode=disable",
)

sys.path.insert(0, "/Users/nuzantara/Desktop/nuzantara/apps/backend-rag")
from backend.services.ingestion.legal_ingestion_service import LegalIngestionService

# Skip PP 41/1996 (already done in single test). 7 remaining.
ITEMS = [
    ("/Users/nuzantara/Desktop/nuzantara/data/source_documents/peraturan/visa/Permenkumham_22-2023.pdf",
     "Permenkumham 22/2023 — Visa Dan Izin Tinggal", "visa", 7128),
    ("/Users/nuzantara/Desktop/nuzantara/data/source_documents/peraturan/visa/Permenkumham_11-2024.pdf",
     "Permenkumham 11/2024 — Golden Visa C-318", "visa", 11238),
    ("/Users/nuzantara/Desktop/nuzantara/data/source_documents/peraturan/property/PP_13-2017.pdf",
     "PP 13/2017 — RTRWN Amendment", "property", 245),
    ("/Users/nuzantara/Desktop/nuzantara/data/source_documents/peraturan/property/Permen_ATR-BPN_18-2021.pdf",
     "Permen ATR/BPN 18/2021 — Hak Pengelolaan", "property", 4870),
    ("/Users/nuzantara/Desktop/nuzantara/data/source_documents/peraturan/tax/PER-7-PJ-2025.pdf",
     "PER-7/PJ/2025 — NIK-NPWP Coretax", "tax", 612),
    ("/Users/nuzantara/Desktop/nuzantara/data/source_documents/peraturan/tax/PMK_9-PMK.03-2018.pdf",
     "PMK 9/PMK.03/2018 — SPT Filing Periods", "tax", 285),
    ("/Users/nuzantara/Desktop/nuzantara/data/source_documents/peraturan/tax/KEP-55-PJ-2026.pdf",
     "KEP-55/PJ/2026 — Coretax Penalty Waiver", "tax", 55),
]

OUTPUT = "/tmp/qdrant_ingest_results_v2.json"
PER_FILE_TIMEOUT_SEC = 600  # 10 min per file


async def ingest_one(service, path, title, domain):
    return await service.ingest_legal_document(file_path=path, title=title, category=domain)


async def main():
    service = LegalIngestionService(collection_name="legal_unified_2026")
    print("[init] LegalIngestionService ready", flush=True)
    results = []
    for path, title, domain, expected_kb in ITEMS:
        record = {"path": path, "title": title, "domain": domain,
                  "started_at": datetime.utcnow().isoformat()}
        if not os.path.exists(path):
            record["status"] = "missing"
            results.append(record)
            print(f"[skip] {title}: missing", flush=True)
            continue
        actual_kb = os.path.getsize(path) // 1024
        record["size_kb"] = actual_kb
        print(f"[start] {title} ({actual_kb} KB)", flush=True)
        t0 = time.time()
        try:
            r = await asyncio.wait_for(
                ingest_one(service, path, title, domain),
                timeout=PER_FILE_TIMEOUT_SEC,
            )
            elapsed = time.time() - t0
            record["status"] = "ok"
            record["elapsed_sec"] = round(elapsed, 1)
            record["chunks_created"] = r.get("chunks_created") if isinstance(r, dict) else None
            record["result_str"] = str(r)[:500]
            print(f"[done]  {title} → chunks={record.get('chunks_created')} in {elapsed:.0f}s",
                  flush=True)
        except asyncio.TimeoutError:
            record["status"] = "timeout"
            record["elapsed_sec"] = PER_FILE_TIMEOUT_SEC
            print(f"[TIMEOUT] {title} after {PER_FILE_TIMEOUT_SEC}s", flush=True)
        except Exception as e:
            elapsed = time.time() - t0
            record["status"] = "error"
            record["elapsed_sec"] = round(elapsed, 1)
            record["error"] = f"{type(e).__name__}: {str(e)[:300]}"
            print(f"[ERROR] {title}: {type(e).__name__}: {str(e)[:200]}", flush=True)
        record["completed_at"] = datetime.utcnow().isoformat()
        results.append(record)
        # Save partial after each (resilience)
        with open(OUTPUT, "w") as f:
            json.dump(results, f, indent=2, default=str)

    print(f"\n[FINAL] {OUTPUT}", flush=True)
    ok = sum(1 for r in results if r.get("status") == "ok")
    chunks_total = sum(r.get("chunks_created", 0) or 0 for r in results)
    print(f"Summary: {ok}/{len(results)} ok, {chunks_total} chunks total", flush=True)


if __name__ == "__main__":
    asyncio.run(main())
