<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Bali Zero Nuzantara agent-library-evolver — weekly LaunchAgent

         Spec: docs/superpowers/specs/2026-05-17-agent-library-evoskill-design.md
         Phase 1 — bootstrapped in Task #26 (this file is the git-tracked
         source of truth per cicatrix scar 2026-04-29 plist corruption).

         To install + bootstrap:
             cp infra/launchd/com.balizero.agent-library-evolver.weekly.plist \
                ~/Library/LaunchAgents/
             launchctl bootstrap gui/$(id -u) \
                 ~/Library/LaunchAgents/com.balizero.agent-library-evolver.weekly.plist

         To unload (if you need to update the plist):
             launchctl bootout gui/$(id -u) \
                 ~/Library/LaunchAgents/com.balizero.agent-library-evolver.weekly.plist

         To trigger NOW (smoke test):
             launchctl kickstart -k gui/$(id -u)/com.balizero.agent-library-evolver.weekly

         Per-run BUDGET_USD override:
             launchctl setenv BUDGET_USD 0.10 && launchctl kickstart -k \
                 gui/$(id -u)/com.balizero.agent-library-evolver.weekly
    -->

    <key>Label</key>
    <string>com.balizero.agent-library-evolver.weekly</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/nuzantara/Desktop/nuzantara/scripts/agent-library-evolver-run.sh</string>
    </array>

    <!-- Sunday 03:00 WITA (after wr2 Reflexion 02:30, before Mon SessionStart) -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Weekday</key>
      <integer>0</integer>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <!-- Cron pattern: short-lived weekly run, NOT a long-running daemon -->
    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>

    <!-- Working dir = repo root so relative paths in run.sh resolve -->
    <key>WorkingDirectory</key>
    <string>/Users/nuzantara/Desktop/nuzantara</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>SECRETS_FILE</key>
      <string>/Users/nuzantara/.nuzantara-secrets.env</string>
      <key>REPO_ROOT</key>
      <string>/Users/nuzantara/Desktop/nuzantara</string>
      <key>TELEMETRY_DIR</key>
      <string>/Users/nuzantara/.agent/decisions/agent-library-evolver/telemetry</string>
      <!-- Budget default $1.00 prod. Override per-run via:
             launchctl setenv BUDGET_USD 0.10
           before kickstart for smoke. -->
      <key>BUDGET_USD</key>
      <string>1.00</string>
    </dict>

    <!-- Logs (survive reboots — out of /tmp, L11 fix) -->
    <key>StandardOutPath</key>
    <string>/Users/nuzantara/logs/agent-library-evolver.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/logs/agent-library-evolver.err.log</string>

    <!-- macOS LaunchAgent low-priority CPU class — weekly cron, not interactive -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- Nice value: be polite if Sunday 03:00 collides with other crons -->
    <key>Nice</key>
    <integer>5</integer>
  </dict>
</plist>
