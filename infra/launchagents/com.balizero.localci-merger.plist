<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.balizero.localci-merger</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>MERGER_NODE</key>
        <string>Nuzantara</string>
        <key>MERGER_PYTHON</key>
        <string>__HOME__/.nuzantara-pilots/local-ci/merger/venv/bin/python</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.nuzantara-cron/localci_merger_tick.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/logs/localci-merger.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/logs/localci-merger.err.log</string>
</dict>
</plist>
