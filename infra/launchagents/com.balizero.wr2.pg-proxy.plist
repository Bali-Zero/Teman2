<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.balizero.wr2.pg-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/fly</string>
        <string>proxy</string>
        <string>15432:5432</string>
        <string>-a</string>
        <string>nuzantara-postgres</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/nuzantara/.openclaw/workspace/logs/war-room-v2/pg-proxy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/.openclaw/workspace/logs/war-room-v2/pg-proxy.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nuzantara</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
