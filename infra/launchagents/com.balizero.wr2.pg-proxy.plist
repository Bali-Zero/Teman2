<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/nuzantara</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.balizero.wr2.pg-proxy</string>
	<key>Program</key>
	<string>/Users/nuzantara/scripts/fly-pg-proxy-wrapper.sh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nuzantara/scripts/fly-pg-proxy-wrapper.sh</string>
	</array>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/nuzantara/.openclaw/workspace/logs/war-room-v2/pg-proxy.error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/nuzantara/.openclaw/workspace/logs/war-room-v2/pg-proxy.log</string>
</dict>
</plist>
