<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.nuzantara.secrets-permissions-audit — superscar #4 auditor, LaunchAgent
  mode. Runs scripts/secrets_permissions_audit.py in notify mode hourly:
  findings go to the Telegram gateway (tg_notify.py), nothing is chmod'ed. Canon
  (flag semantics, alert text, exit codes) lives in the script itself; this
  file only schedules it. Umask 0077 applies to files the JOB creates; it does
  NOT apply to StandardOutPath/StandardErrorPath, which launchd creates itself
  under its own umask — every ~/logs/*.log on this fleet is 0644, measured, and
  the log DOES list credential paths (never contents). So the log files are
  pre-created 0600 below: launchd appends to an existing inode and keeps its
  mode (Kimi council seat, finding M3 — the previous comment here claimed the
  Umask covered them, and it did not).

  Install:
    umask 077 && : >> ~/logs/secrets-permissions-audit.log \
      && : >> ~/logs/secrets-permissions-audit.error.log \
      && chmod 600 ~/logs/secrets-permissions-audit.log \
                   ~/logs/secrets-permissions-audit.error.log && \
    install -m 0644 infra/launchagents/com.nuzantara.secrets-permissions-audit.plist \
      ~/Library/LaunchAgents/ && \
    launchctl bootstrap gui/$(id -u) \
      ~/Library/LaunchAgents/com.nuzantara.secrets-permissions-audit.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nuzantara.secrets-permissions-audit</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nuzantara</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/nuzantara/nuzantara/scripts/secrets_permissions_audit.py</string>
        <string>--notify</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nuzantara/nuzantara</string>

    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>/Users/nuzantara/logs/secrets-permissions-audit.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/logs/secrets-permissions-audit.err.log</string>
</dict>
</plist>
