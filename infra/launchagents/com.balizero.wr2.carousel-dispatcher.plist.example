<?xml version="1.0" encoding="UTF-8"?>
<!--
WR2 carousel dispatcher — PG NOTIFY listener daemon (always-on)
Spec: research/wr2/2026-05-27-wr2-autonomous-workflow-spec.md §1

Install (Pro):
    cp infra/launchagents/com.balizero.wr2.carousel-dispatcher.plist.example \
       ~/Library/LaunchAgents/com.balizero.wr2.carousel-dispatcher.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.balizero.wr2.carousel-dispatcher.plist

Kill switch:
    launchctl setenv WR2_DISPATCHER_ENABLED false
    OR: launchctl bootout gui/$(id -u)/com.balizero.wr2.carousel-dispatcher
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.balizero.wr2.carousel-dispatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nuzantara/Desktop/nuzantara/apps/backend-rag/.venv/bin/python</string>
        <string>/Users/nuzantara/Desktop/nuzantara/scripts/wr2_carousel_dispatcher.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nuzantara/Desktop/nuzantara</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>WR2_DISPATCHER_ENABLED</key>
        <string>true</string>
        <key>AGENT_BROKER_ENABLED</key>
        <string>true</string>
        <key>DATABASE_URL</key>
        <string>postgresql://backend_rag_v2:PASSWORD@127.0.0.1:15432/nuzantara_rag?sslmode=disable</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nuzantara/logs/wr2-carousel-dispatcher.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/logs/wr2-carousel-dispatcher.error.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
