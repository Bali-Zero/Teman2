<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- kb-current-live campaign, orchestrator lane (2026-08-25). Runs
     kb/ops/probe_history.py record four times a day so MANDATE §8's own
     definition of done ("stayed green for 48h under the scheduled job") has a
     scheduled job to point at. One-shot script on a calendar interval, exactly
     the regulatory-watcher shape (KeepAlive=false, no blocking loop needed —
     superscar #7 does not apply to this shape). Six-hour cadence is well under
     kb/ops/probe_history.py's own MAX_GAP_HOURS=24 tolerance, so a single missed
     tick never breaks a real streak by itself.

     NOT INSTALLED (see .claude/skills/modus/PENDING-ARMS.md for the precondition
     this is waiting on — kb/journeys/ holds zero real topic files today, and a
     scheduled job with nothing to probe would just be superscar #2 in advance).
     Pro-resident job: paths are Pro's user (nuzantara) by design; installers
     adapt per machine, same convention as com.balizero.regulatory-watcher.daily. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nuzantara.kb-probe-history.6h</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/nuzantara/nuzantara &amp;&amp; apps/backend-rag/.venv/bin/python3 kb/ops/probe_history.py record --collection legal_unified &gt;&gt; /Users/nuzantara/logs/kb-probe-history.log 2&gt;&amp;1</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/nuzantara/logs/kb-probe-history.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/logs/kb-probe-history.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nuzantara</string>
        <key>PATH</key>
        <string>/Users/nuzantara/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
