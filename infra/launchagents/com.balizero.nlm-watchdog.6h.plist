<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.balizero.nlm-watchdog.6h</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/balizero/.nuzantara-cron/nlm_watchdog_cron.sh</string>
    </array>
    <!-- Cron puro: StartInterval, NO KeepAlive (scar #7 daemon-vs-cron).
         21600s = ogni 6h, stessa cadenza di auth-sentinel — un tick copre
         login-liveness Pro + cap notebook + freschezza inventario insieme. -->
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <true/>
    <!-- Log FUORI da ~/Desktop (W84: launchd perde TCC su Desktop). -->
    <key>StandardOutPath</key>
    <string>/Users/balizero/.local/state/nlm-watchdog/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/balizero/.local/state/nlm-watchdog/launchd.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
