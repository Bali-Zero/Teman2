<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mini install prerequisite (the two &#45; entities in each option spell an ASCII option prefix):
    ~/.local/bin/uv venv &#45;&#45;python /opt/homebrew/bin/python3 ~/.local/share/nuzantara/detect-secrets-venv &amp;&amp; ~/.local/bin/uv pip install &#45;&#45;python ~/.local/share/nuzantara/detect-secrets-venv/bin/python detect-secrets==&lt;version&gt;
    where &lt;version&gt; is the "version" field of .secrets.baseline on main (the wrapper's tool error names it).
  Then install the wrapper and plist from their declared repo paths and create the log directory mode 700.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nuzantara.detect-secrets-fulltree</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nuzantara/scripts/mini-detect-secrets.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/nuzantara/nuzantara</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ExitTimeOut</key>
    <integer>60</integer>
    <key>Umask</key>
    <integer>63</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nuzantara</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/nuzantara/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/nuzantara/logs/mini-detect-secrets/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/logs/mini-detect-secrets/launchd.err.log</string>
</dict>
</plist>
