<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/nuzantara</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.balizero.claude-settings-watcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nuzantara/scripts/claude-settings-change-alert.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/nuzantara/logs/claude-settings-watcher.err</string>
	<key>StandardOutPath</key>
	<string>/Users/nuzantara/logs/claude-settings-watcher.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WatchPaths</key>
	<array>
		<string>/Users/nuzantara/.claude/settings.json</string>
	</array>
</dict>
</plist>
