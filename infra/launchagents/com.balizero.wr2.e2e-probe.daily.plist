<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.balizero.wr2.e2e-probe.daily</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nuzantara</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nuzantara/scripts/wr2-probe-cron.sh</string>
    </array>

    <!-- Daily at 04:00 WITA (off-hours, low Fly contention) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nuzantara/logs/wr2-probe-cron.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/logs/wr2-probe-cron.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
