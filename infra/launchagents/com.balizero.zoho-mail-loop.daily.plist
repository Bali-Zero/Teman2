<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily Zoho mail loop.

  StartCalendarInterval and NO KeepAlive, deliberately. This is a cron, not a
  daemon: it runs once, exits, and is done. `KeepAlive=true` on a one-shot
  payload reads every exit as death and produces a restart storm (superscar #7,
  W67 — the wa-mirror reconnect storm was exactly this, ~22s per cycle).

  Runs at 07:30 WITA, before the working day, so the drafts are already in the
  Drafts folder when Zero opens his mailbox.

  MAIL_LOOP_DRY_RUN was 1 for the first days, on purpose, so the organ could be
  observed without mutating a live mailbox. FLIPPED TO 0 on 2026-08-05, after
  the router stopped filing mail on coincidences (PR #3603: six of seven live
  routings had rested on a single soft marker, five of them the word "tax").
  Measured before flipping: of 13 unread, 1 moves and 1 draft is written. The
  loop still never sends. To go back, set this to 0 -> 1 and reload; the
  original wording of the rest of this comment is preserved below because it is
  still the reason the gate existed. Do NOT edit this file with PlistBuddy — it
  rewrites the XML and silently drops these comments (measured: 63 lines -> 43).
  Flip it to 0 (or drop the
  key) once the routing has been read and the folder taxonomy is right.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.balizero.zoho-mail-loop.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nuzantara/nuzantara/scripts/zoho-mail-loop.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/nuzantara</string>
        <key>MAIL_LOOP_REPO_ROOT</key>
        <string>/Users/nuzantara/nuzantara</string>
        <key>MAIL_LOOP_EMAIL</key>
        <string>zero@balizero.com</string>
        <key>MAIL_LOOP_DRY_RUN</key>
        <string>0</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nuzantara/logs/zoho-mail-loop.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nuzantara/logs/zoho-mail-loop.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
