{
  "coworkSecurity": {
    "version": "1.0",
    "whitelists": {
      "sensitiveDirectories": [
        "/Users/antonellosiano/.ssh",
        "/Users/antonellosiano/.aws",
        "/Users/antonellosiano/.config"
      ],
      "protectedFiles": [
        "*.key",
        "*.pem",
        "*.env",
        "*secret*",
        "*password*",
        "service-account-key.json"
      ]
    },
    "backup": {
      "autoBackupBefore": ["delete", "replace", "move"],
      "backupDirectory": "~/Desktop/nuzantara/.cowork-optimization/backups/auto",
      "maxBackupSize": "100MB",
      "retention": "30days"
    },
    "logging": {
      "enabled": true,
      "level": "info",
      "logDirectory": "~/Desktop/nuzantara/.cowork-optimization/logs",
      "logActions": [
        "file_delete",
        "file_move",
        "file_replace",
        "permission_change"
      ],
      "maxLogSize": "10MB"
    },
    "limits": {
      "maxFileSize": "10MB",
      "maxBatchOperations": 100,
      "maxConcurrentTasks": 3,
      "taskTimeout": "10m"
    },
    "notifications": {
      "criticalActions": true,
      "errorAlerts": true,
      "summaryReports": "daily"
    }
  }
}
