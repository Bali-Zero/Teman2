\f1\b \cf2 \cb3 Le Esclusioni (Il Limite "Hard")\
\pard\pardeftab720\sa160\partightenfactor0

\f2\b0 \cf2 Nonostante la liberalizzazione, rimangono delle barriere rigide per prevenire la speculazione immobiliare mascherata da investimento produttivo.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa160\partightenfactor0
\ls5\ilvl0
