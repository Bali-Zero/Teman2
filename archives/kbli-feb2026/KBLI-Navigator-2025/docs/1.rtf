\f1\b\fs40 \cf2 \strokec2 6. Caso Studio Ipotetico: Il Vantaggio per le Startup Tech\
\pard\pardeftab720\sa320\partightenfactor0

\f2\b0\fs32 \cf2 Per illustrare l'applicazione pratica del Regolamento BKPM 5/2025, esaminiamo uno scenario ipotetico di una startup Fintech basata a Singapore, "NusantaraPay", che entra in Indonesia.\
\pard\pardeftab720\sa160\partightenfactor0

\f1\b \cf2 6.1 L'Applicazione "Factoryless"\
\pard\pardeftab720\sa160\partightenfactor0

\f2\b0 \cf2 Sotto il vecchio regime, NusantaraPay avrebbe faticato a giustificare un investimento di 10 miliardi di IDR. Non hanno bisogno di una fabbrica; hanno bisogno di un ufficio in co-working e crediti cloud.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa160\partightenfactor0
\ls12\ilvl0
\f1\b \cf2 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Vecchio Attrito:
\f2\b0 \'a0I funzionari del BKPM spesso respingevano il "Capitale Circolante" eccedente i 3 mesi, chiedendo di vedere "Asset Solidi".\cb1 \
\ls12\ilvl0
\f1\b \cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Nuova Realt\'e0:
\f2\b0 \'a0Sotto il Reg. 5/2025, NusantaraPay seleziona il codice\'a0
\f1\b KBLI 62019
\f2\b0 \'a0(Altre attivit\'e0 di programmazione informatica).\cb1 \
\pard\tx940\tx1440\pardeftab720\li1440\fi-1440\sa160\partightenfactor0
\ls12\ilvl1
\f1\b \cf2 \cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Versamento:
\f2\b0 \'a0Iniettano\'a0
\f1\b 2,5 miliardi di IDR
\f2\b0 . Questo copre la loro "runway" per i primi 12 mesi (2 sviluppatori a 30M/mese, 1 Country Manager a 50M/mese, affitto ufficio, tariffe AWS). I fondi sono bloccati ma\'a0
\f3\i utilizzati
\f2\i0 \'a0attivamente ogni mese per pagare queste spese.\cb1 \
\ls12\ilvl1
\f1\b \cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Piano di Investimento:
\f2\b0 \'a0Proiettano\'a0
\f1\b 11 miliardi di IDR
\f2\b0 \'a0su 3 anni nel sistema OSS.\cb1 \
\pard\tx1660\tx2160\pardeftab720\li2160\fi-2160\sa160\partightenfactor0
\ls12\ilvl2\cf2 \cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Anno 1: 2,5 Mld (L'iniezione iniziale).\cb1 \
\ls12\ilvl2\cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Anno 2: 4,0 Mld (Finanziati dal reinvestimento dei ricavi + Serie A).\cb1 \
\ls12\ilvl2\cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Anno 3: 4,5 Mld (Espansione e marketing).\cb1 \
\pard\tx940\tx1440\pardeftab720\li1440\fi-1440\sa160\partightenfactor0
\ls12\ilvl1
