{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "bali-zero-brand-tokens",
    "version": "1.0.0",
    "owner": "Antonello Siano",
    "last_revised": "2026-05-08",
    "namespace": "closed",
    "comment": "Closed namespace. wr2-design-architect references token names only, never hex codes."
  },
  "color": {
    "bg": {
      "antracite": { "value": "#2C2F38", "type": "color", "role": "primary background" },
      "black": { "value": "#000000", "type": "color", "role": "secondary background, hero overlay" }
    },
    "text": {
      "white": { "value": "#FFFFFF", "type": "color", "role": "body text, headlines" },
      "muted": { "value": "#9CA3AF", "type": "color", "role": "sources, captions, footer (rare)" }
    },
    "accent": {
      "yellow": { "value": "#F4C430", "type": "color", "role": "data, sub-headlines, key numbers" }
    },
    "status": {
      "red": { "value": "#C8102E", "type": "color", "role": "logo, critical alerts (STOPPED, CRIMINAL)" }
    },
    "overlay": {
      "darken-60": { "value": "rgba(0,0,0,0.6)", "type": "color", "role": "photo legibility gradient on text zones" },
      "darken-40": { "value": "rgba(0,0,0,0.4)", "type": "color", "role": "subtle photo darkening" }
    }
  },
  "font": {
    "family": {
      "primary": { "value": "'Montserrat', 'Inter', 'Poppins', sans-serif", "type": "fontFamily", "role": "all text — single family rule" },
      "mono": { "value": "'IBM Plex Mono', monospace", "type": "fontFamily", "role": "source citation footer only" }
    },
    "weight": {
      "bold": { "value": 700, "type": "fontWeight", "role": "body" },
      "extrabold": { "value": 800, "type": "fontWeight", "role": "headline, statement-bomb" }
    },
    "size": {
      "headline-cover": { "value": "84px", "type": "dimension", "role": "cover slide title" },
      "headline-slide": { "value": "60px", "type": "dimension", "role": "regular slide title" },
      "subheadline": { "value": "36px", "type": "dimension", "role": "yellow accent sub-title" },
      "body-lg": { "value": "32px", "type": "dimension", "role": "primary body text" },
      "body-md": { "value": "28px", "type": "dimension", "role": "secondary body / list items" },
      "source": { "value": "14px", "type": "dimension", "role": "source citation footer" },
      "statement-bomb": { "value": "72px", "type": "dimension", "role": "closing slide single-line statement" }
    },
    "letter-spacing": {
      "title": { "value": "0.02em", "type": "dimension", "role": "all headlines and titles" },
      "body": { "value": "0em", "type": "dimension", "role": "body text" }
    },
    "line-height": {
      "tight": { "value": 1.05, "type": "number", "role": "headlines, statement-bomb" },
      "snug": { "value": 1.2, "type": "number", "role": "sub-headlines" },
      "normal": { "value": 1.4, "type": "number", "role": "body" }
    }
  },
  "spacing": {
    "edge-margin": { "value": "60px", "type": "dimension", "role": "outer canvas padding" },
    "logo-bottom": { "value": "70px", "type": "dimension", "role": "logo distance from bottom edge" },
    "section-gap": { "value": "40px", "type": "dimension", "role": "between heading and body" },
    "list-gap": { "value": "16px", "type": "dimension", "role": "between list items" }
  },
  "size": {
    "canvas": {
      "width": { "value": 1080, "type": "dimension" },
      "height": { "value": 1350, "type": "dimension" },
      "aspect": { "value": "4:5", "type": "string" }
    },
    "logo": {
      "diameter": { "value": "80px", "type": "dimension" }
    }
  },
  "image": {
    "style": {
      "grading": { "value": "teal-amber", "type": "string", "role": "Villeneuve/Deakins reference cinematic color grading" },
      "lighting": { "value": "chiaroscuro", "type": "string", "role": "high contrast directional light" },
      "format": { "value": "35mm-film", "type": "string", "role": "editorial cinematic look — grain visible" },
      "saturation": { "value": "low-outside-palette", "type": "string", "role": "desaturate non-palette hues" }
    },
    "ai-prompt-cameras": {
      "value": ["ARRI Alexa Mini LF", "Hasselblad X2D", "RED V-Raptor", "Leica M11"],
      "type": "array",
      "role": "include one in image generation prompts for stylistic anchor"
    }
  },
  "swipe_indicator": {
    "size": { "value": "12px", "type": "dimension", "role": "yellow dot signal of carousel continuation, added 2026-05-12 (SOTA pattern #10)" },
    "color": { "value": "color.accent.yellow", "type": "tokenRef", "role": "visible accent on dark bg" },
    "position": { "value": "bottom-right", "type": "string", "role": "consistent across slides 2..N-1" },
    "offset": { "value": "32px", "type": "dimension", "role": "distance from canvas edges" },
    "applies_to_slides": { "value": "2..N-1", "type": "string", "role": "NOT cover (slide 1), NOT last slide" }
  },
  "regulation_badge": {
    "bg": { "value": "color.accent.yellow", "type": "tokenRef", "role": "yellow rounded badge for regulation code top-right (revised 2026-05-13 — was red, WCAG 2.27:1 FAIL on antracite; yellow=8.14:1 AAA vs antracite + black text=12.79:1 AAA inside)" },
    "text": { "value": "color.bg.black", "type": "tokenRef", "role": "black text on yellow for AAA contrast (revised 2026-05-13)" },
    "font": { "value": "font.family.mono", "type": "tokenRef", "role": "IBM Plex Mono for code-like legibility" },
    "size": { "value": "16px", "type": "dimension" },
    "padding": { "value": "6px 12px", "type": "string" },
    "border_radius": { "value": "4px", "type": "dimension" },
    "position": { "value": "top-right", "type": "string" },
    "offset": { "value": "32px", "type": "dimension" },
    "applies_to": { "value": "cover slide ONLY when brief.primary_regulation_code is present (added 2026-05-12, SOTA pattern #3, revised 2026-05-13 for WCAG AAA)" },
    "_revision_2026_05_13": { "value": "Previous: red bg #C8102E + white text — WCAG audit found badge vs antracite bg = 2.27:1 (FAIL). Migration: bg → accent.yellow #F4C430 (8.14:1 AAA vs antracite), text → bg.black (12.79:1 AAA). Yellow becomes the family color for 'verifiable facts' (anchors Art 6.9 + regulation badge unified). Red retained for: logo, status critical alerts on white bg, red rule divider lines." }
  },
  "qr_closing": {
    "size": { "value": "120px", "type": "dimension", "role": "QR code in elegant-close slide (added 2026-05-12, SOTA pattern #25)" },
    "border": { "value": "2px solid color.status.red", "type": "string" },
    "position": { "value": "bottom-right", "type": "string" },
    "offset": { "value": "60px", "type": "dimension" },
    "target": { "value": "primary_source_url (DJP / OSS / JDIH / Permenkumham PDF) — NEVER Bali Zero own site (Art 6.6 hard-sell ban)", "type": "string" }
  },
  "logo": {
    "mark": { "value": "3 ALI ZERO", "type": "string", "role": "wordmark, never alter spacing" },
    "asset_path": { "value": "~/.claude/skills/bali-zero-brand/assets/logo.png", "type": "string", "role": "official PNG asset 940x940 RGBA — black circle, red 3, white ALI ZERO, om symbol bottom-right" },
    "asset_filename_in_slides": { "value": "logo.png", "type": "string", "role": "renderer copies asset to each slides dir; CSS background-image: url('logo.png')" },
    "color-on-light": { "value": "color.bg.black", "type": "tokenRef", "role": "logo has its own black-circle background — appears on any slide bg" },
    "color-on-dark": { "value": "color.bg.black", "type": "tokenRef" },
    "position": { "value": "centered-bottom", "type": "string" }
  },
  "layout_defaults": {
    "_comment": "Per-layout-family design defaults. Renderer loads at boot. Override per-slide via slides.json field (e.g. heading_color: 'white'). Valid values: 'yellow' | 'white'. Last revised: 2026-05-16.",
    "dark-status-list":          { "heading_color": "yellow" },
    "timeline-pinboard":         { "heading_color": "yellow" },
    "three-verdicts":            { "heading_color": "yellow" },
    "thin-red-rule-divider":     { "heading_color": "yellow" },
    "swiss-grid-asymmetry":      { "heading_color": "yellow" },
    "evidence-carved":           { "heading_color": "white" },
    "monospace-evidence-block":  { "heading_color": "white" },
    "qa-dialogue":               { "heading_color": "white" },
    "cover-photo":               { "heading_color": "white" },
    "cover":                     { "heading_color": "white" },
    "photo-headline-yellow-sub": { "heading_color": "white" },
    "stat-card-hero":            { "heading_color": "yellow" },
    "statement-bomb":            { "heading_color": "white" },
    "elegant-close":             { "heading_color": "yellow" }
  },
  "banned": {
    "colors": {
      "value": ["#00FF00", "#0000FF", "#800080", "#FFC0CB", "#F5F5DC", "#A52A2A", "any-green-shade", "any-blue-shade", "any-purple-shade", "any-pastel", "beige", "brown"],
      "type": "array",
      "role": "hard fail in critic ONLY for text-zones, UI elements, logo. NOT applied inside hero-photo zone (cinematic teal-amber grading allowed). See constitution Article 2.3 region-aware enforcement."
    },
    "fonts": {
      "value": ["any-serif", "any-script", "any-display", "any-handwritten", "Comic Sans", "Times New Roman", "Georgia", "Cormorant Garamond", "Pacifico", "Lobster"],
      "type": "array",
      "role": "hard fail — Cormorant Garamond was in old packages/core/tokens/primitives.css but is BANNED for WR2 carousels (different brand surface)"
    }
  }
}
