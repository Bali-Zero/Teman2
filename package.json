{
  "name": "nuzantara",
  "version": "5.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/mouth",
    "apps/admin-dashboard",
    "apps/admin-dashboard-local",
    "apps/autonomous-lab",
    "apps/web",
    "packages/core",
    "packages/ts-schemas"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "lint:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "npm run test:ci -w apps/mouth",
    "test:coverage": "npm run test:coverage -w apps/mouth",
    "test:ci": "npm run test:ci -w apps/mouth",
    "health-check": "curl -s http://localhost:8080/health | jq . || echo 'Server not running on port 8080'",
    "test:integration": "npm run build && npm run test:ci",
    "test:health": "curl -s localhost:8080/health | jq",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "docs:generate": "npx tsx scripts/analysis/extract-handlers-docs.ts && npx tsx scripts/analysis/extract-project-context.ts",
    "docs:handlers": "npx tsx scripts/analysis/extract-handlers-docs.ts",
    "docs:context": "npx tsx scripts/analysis/extract-project-context.ts",
    "ai:enter": "bash .claude/scripts/enter-window.sh",
    "ai:exit": "bash .claude/scripts/exit-window.sh",
    "ai:sync": "bash .claude/scripts/sync-coordination.sh",
    "ai:check-lock": "bash .claude/scripts/check-lock.sh",
    "ai:setup-cron": "bash .claude/scripts/setup-cron.sh",
    "ai:cleanup": "find .claude/handovers -name '*.md' -mtime +7 -delete && echo 'Handovers >7 giorni eliminati'",
    "ai:reset-all": "echo '⚠️  Reset completo - tutti locks e stati saranno cancellati!' && rm -f .claude/locks/active.txt && bash .claude/scripts/sync-coordination.sh && echo 'Reset completato'",
    "ai:agent": "gemini -p",
    "typecheck": "npm run typecheck -w apps/mouth",
    "devai:test": "./test-devai.sh",
    "devai:analyze": "node -e \"console.log('Use: curl /call -d {key:devai.analyze,params:{code:...}}')\"",
    "devai:fix-typescript": "npm run typecheck 2>&1 | head -50",
    "test:auto-generate": "python3 scripts/test_automation/test_generator.py",
    "test:auto-generate:dry": "python3 scripts/test_automation/test_generator.py --dry-run",
    "test:coverage-monitor": "python3 scripts/test_automation/coverage_monitor.py 90",
    "test:quality-check": "python3 scripts/test_automation/test_quality_checker.py",
    "test:automation": "bash scripts/test_automation/test_master.sh 90",
    "test:automation:dry": "bash scripts/test_automation/test_master.sh 90 true",
    "coverage:gate": "bash scripts/coverage/gate.sh",
    "coverage:gate:generate": "bash scripts/coverage/gate.sh --generate-coverage",
    "coverage:report": "bash scripts/coverage/report.sh",
    "coverage:diff:backend": "python3 scripts/coverage/diff_coverage_py.py",
    "coverage:diff:frontend": "node scripts/coverage/diff_coverage_lcov.mjs",
    "optimize:images": "node scripts/optimize-images.cjs",
    "workspace:install": "npm install",
    "workspace:clean": "rm -rf node_modules apps/*/node_modules package-lock.json",
    "workspace:reset": "npm run workspace:clean && npm install"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "description": "**Production-ready AI platform powered by ZANTARA - Bali Zero's intelligent business assistant**",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "resolutions": {
    "path-to-regexp": "^8.0.0",
    "hono": ">=4.12.31",
    "@hono/node-server": ">=2.0.11",
    "find-my-way": ">=9.7.0",
    "@isaacs/brace-expansion": ">=5.0.1",
    "undici": "~7.28.0",
    "next": ">=16.2.11",
    "dompurify": ">=3.4.0",
    "qs": ">=6.16.0",
    "brace-expansion": ">=5.0.9",
    "valibot": ">=1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": ">=0.35.3"
  },
  "overrides": {
    "path-to-regexp": "^8.0.0",
    "hono": ">=4.12.31",
    "dompurify": ">=3.4.0",
    "@hono/node-server": ">=2.0.11",
    "find-my-way": ">=9.7.0",
    "@isaacs/brace-expansion": ">=5.0.1",
    "undici": ">=8.10.0",
    "next": ">=16.2.11",
    "flatted": ">=3.4.2",
    "minimatch": ">=9.0.5",
    "rollup": ">=4.60.0",
    "picomatch": ">=4.0.4",
    "effect": ">=3.20.0",
    "deepmerge-ts": ">=8.0.0",
    "handlebars": ">=4.7.9",
    "brace-expansion": ">=5.0.9",
    "valibot": ">=1.4.2",
    "vite": ">=8.0.4",
    "follow-redirects": ">=1.16.0",
    "uuid": ">=14.0.0",
    "postcss": ">=8.5.10",
    "fast-uri": ">=3.1.2",
    "ip-address": ">=10.2.0",
    "qs": ">=6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": ">=0.35.3",
    "@redocly/openapi-core": {
      "js-yaml": "4.3.1"
    }
  }
}
