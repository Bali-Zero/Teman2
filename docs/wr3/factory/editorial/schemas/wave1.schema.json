{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "working_title",
          "domain",
          "core_evergreen_question",
          "target_audience",
          "recurring_human_tension",
          "why_intriguing",
          "why_still_relevant_in_three_years",
          "narrative_promise",
          "regulatory_volatility",
          "sourceability",
          "banality_risk"
        ],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^[AGQ][0-9]{2}$" },
          "working_title": { "type": "string", "minLength": 1 },
          "domain": { "enum": ["immigration", "company", "tax", "property"] },
          "core_evergreen_question": { "type": "string", "minLength": 1 },
          "target_audience": { "type": "string", "minLength": 1 },
          "recurring_human_tension": { "type": "string", "minLength": 1 },
          "why_intriguing": { "type": "string", "minLength": 1 },
          "why_still_relevant_in_three_years": {
            "type": "string",
            "minLength": 1
          },
          "narrative_promise": { "type": "string", "minLength": 1 },
          "regulatory_volatility": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "sourceability": { "type": "integer", "minimum": 0, "maximum": 100 },
          "banality_risk": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
