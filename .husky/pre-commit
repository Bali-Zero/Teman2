# ── Redis Lease Registry hot-zone check (SOTA wave 2026-05-24) ──────────────
# Closes cicatrix family W40/W50/W51/W52 (concurrent agent sessions mutating
# shared hot-zone paths: LaunchAgent wrappers, migrations_v2/*.sql, sentinel
# scripts, auth/billing/pricing services, .github/workflows/*).
#
# Behavior:
#   - For each staged file matching a HOT_ZONE_REGEX, calls
#     `python3 scripts/agent_lease.py check <path>`.
#   - If that file is leased by ANOTHER task (per Redis registry) → exit 1
#     with holder details (task_id, host, pid, ttl).
#   - If owned by us ($TASK_ID env) OR free → continue.
#   - Redis down / lib missing → script logs WARN, exits 0 → commit passes.
#   - Kill switch:  AGENT_LEASE_ENFORCEMENT=false  → all checks skipped.
#
# Latency: <500ms target (local Redis <5ms per call, regex pass through small
# staged sets is negligible).

if [ "${AGENT_LEASE_ENFORCEMENT:-true}" != "false" ]; then
    HOT_ZONE_REGEX='^(infra/launchagents/.*\.sh|apps/backend-rag/backend/db/migrations_v2/.*\.sql|shared/escalations.*\.jsonl|scripts/(nuzantara-sentinel|dlq_autopilot|pg-to-organism-bridge)\.py|\.github/workflows/.*|apps/backend-rag/backend/services/(auth|billing|pricing)/.*)$'
    HOT_STAGED=$(git diff --cached --name-only --diff-filter=d | grep -E "$HOT_ZONE_REGEX" || true)
    if [ -n "$HOT_STAGED" ]; then
        echo "🔒 [lease-check] hot-zone files staged — checking Redis lease registry..."
        LEASE_BLOCK=0
        while IFS= read -r path; do
            [ -z "$path" ] && continue
            if ! python3 scripts/agent_lease.py check "$path"; then
                LEASE_BLOCK=1
            fi
        done <<EOF
$HOT_STAGED
EOF
        if [ "$LEASE_BLOCK" -ne 0 ]; then
            echo ""
            echo "❌ ERROR: one or more staged hot-zone paths are leased by another agent task."
            echo "   See docs/runbooks/redis-lease-registry.md for usage."
            echo "   Override (emergency only): AGENT_LEASE_ENFORCEMENT=false git commit ..."
            echo "   If this lease is yours, set TASK_ID=<your-id> in env."
            exit 1
        fi
        echo "✅ [lease-check] no blocking leases on staged hot-zone paths."
    fi
fi

# W41 (2026-05-23): migration-number uniqueness lint when staged files
# touch migrations_v2/. Closes the W40 direct-push bypass — the CI
# workflow lint-migration-numbers.yml only fires on pull_request, so L2
# autonomous-ops direct-push to main would skip it. This catches dup
# prefixes BEFORE the commit lands, before push, before deploy.
MIG_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '^apps/backend-rag/backend/db/migrations_v2/.*\.sql$' || true)
if [ -n "$MIG_FILES" ]; then
    echo "🔢 [W41] Migration number uniqueness lint..."
    if ! python3 scripts/lint_migration_numbers.py; then
        echo ""
        echo "❌ ERROR: duplicate migration number(s) detected."
        echo "   See cicatrix RESOLVED 2026-05-23 W40 + research/operations/2026-05-23-w40-migration-194-collision.md"
        echo "   Convention: the file that arrived SECOND (in git log time) yields and is renamed."
        exit 1
    fi
    echo "🧯 [W42] Migration ROLLBACK marker presence lint..."
    if ! python3 scripts/lint_migration_rollback.py; then
        echo ""
        echo "❌ ERROR: migration > 111 missing inline '-- === ROLLBACK ===' marker."
        echo "   See cicatrix RESOLVED 2026-05-23 W42 + research/operations/2026-05-23-w42-migration-rollback-lint.md"
        echo "   BaseMigration.__init__ requires inline rollback SQL — docs alone don't count."
        exit 1
    fi
fi

# Check for print statements in Python files
echo "🐍 Checking for print() statements in Python files..."
PY_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.py$' || true)
if [ -n "$PY_FILES" ]; then
    # Exclude scripts/ and tests/ from this check (they can use print)
    BACKEND_PY_FILES=$(echo "$PY_FILES" | grep -E '^apps/backend-rag/backend/(app|services|core|middleware)/' || true)
    if [ -n "$BACKEND_PY_FILES" ]; then
        # Use word-boundary check so identifiers ending in "print(" don't false-match
        # (es. _signal_fingerprint(, import_blueprint(). See lessons.md 2026-04-19.
        # Also skip lines starting with `>>>` (Python interactive docstring examples)
        # so docstrings like `>>> print(variants)` don't trip the check.
        if echo "$BACKEND_PY_FILES" | xargs grep -nE '(^|[^a-zA-Z_])print\(' 2>/dev/null | grep -vE ':\s*>>>\s' | grep -q .; then
            echo "❌ ERROR: Found print() statements in backend code."
            echo "   Golden Rule #8: Use logger.info/debug/error() instead"
            echo "   Add: logger = logging.getLogger(__name__)"
            exit 1
        fi
    fi
fi

# Golden Rule #6: No Hardcoding Secrets
echo "🔑 [Golden Rule #6] Checking for hardcoded secrets..."
if [ -n "$PY_FILES" ]; then
    # Exclude tests/ and scripts/ (they use test fixtures with dummy keys)
    BACKEND_SRC_FILES=$(echo "$PY_FILES" | grep -v '/tests/' | grep -v '/scripts/' || true)
    # Check for API key patterns (excluding env vars and comments)
    SECRET_CHECK=$(echo "$BACKEND_SRC_FILES" | xargs grep -E '(api[_-]?key|secret[_-]?key|password)\s*=\s*["\x27][a-zA-Z0-9_-]{16,}' 2>/dev/null | grep -v 'os\.getenv\|settings\.' | grep -v '^\s*#' || true)
    if [ -n "$SECRET_CHECK" ]; then
        echo "❌ ERROR: Potential hardcoded secret found."
        echo "   Golden Rule #6: Use os.getenv() or settings.* for secrets"
        echo "   Example: api_key = os.getenv('OPENAI_API_KEY')"
        exit 1
    fi
fi

# Check for console.log in TypeScript/JavaScript files (exclude webapp browser context and monitoring dashboard)
echo "📜 Checking for console.log statements in TypeScript/JavaScript files..."
JS_FILES=$(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | grep -v 'apps/webapp/src/lib/ai-bridge.ts' | grep -v 'apps/mouth/src/lib/monitoring-dashboard.ts' | grep -v 'apps/mouth/src/app/layout.tsx' | grep -v 'apps/kbli-navigator/' | grep -v 'src/lib/logger\.ts$' | grep -v 'lib/logger\.ts$' | grep -v '/e2e/' | grep -v '/public/' | grep -v '/scripts/' | grep -v 'console\.ts$' | grep -v 'scripts/validate-openapi\.js' | grep -v '\.test\.' | grep -v '\.spec\.' | grep -v '__tests__' || true)
if [ -n "$JS_FILES" ]; then
    if echo "$JS_FILES" | xargs grep -l 'console\.\(log\|debug\|info\|warn\|error\)' 2>/dev/null; then
        echo "❌ ERROR: Found console statements in staged TypeScript/JavaScript files."
        echo "   Please replace console.* with logger from src/lib/logger.ts"
        echo "   Example: import { logger } from '@/lib/logger'; logger.info('message');"
        exit 1
    fi
fi

# Run linting — only on staged TS/JS/JSON/MD/YAML files (not entire repo)
echo "🔧 Running linting..."
LINT_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx|js|jsx|json|md|yml|yaml)$' || true)
if [ -n "$LINT_FILES" ]; then
    echo "$LINT_FILES" | xargs npx prettier --check 2>/dev/null || {
        echo "❌ Linting failed on staged files. Run: npx prettier --write <file>"
