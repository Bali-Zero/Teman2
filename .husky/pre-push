#!/bin/sh
# A normal developer push executes this checked-out hook and resolves its
# helpers from the current worktree.  The unattended autofix runner instead
# sets NUZ_PREPUSH_TRUST_ROOT to a pinned bundle from reviewed main: it is
# deliberately repairing a failed branch, so that branch must not supply the
# classifier, suite lock, or tip-drift verifier governing its outer push.
PREPUSH_TRUST_ROOT="${NUZ_PREPUSH_TRUST_ROOT:-$(pwd -P)}"
case "$PREPUSH_TRUST_ROOT" in
    /*) ;;
    *)
        echo "❌ pre-push trusted root must be absolute; refusing push."
        exit 1
        ;;
esac
PREPUSH_CLASSIFIER="$PREPUSH_TRUST_ROOT/scripts/prepush_classify.py"
PREPUSH_SUITE_LOCK_SOURCE="$PREPUSH_TRUST_ROOT/scripts/prepush_suite_lock.sh"
PREPUSH_TIP_DRIFT_SCRIPT="$PREPUSH_TRUST_ROOT/scripts/ci/prepush_tip_drift.sh"
if [ ! -f "$PREPUSH_CLASSIFIER" ] || [ ! -x "$PREPUSH_SUITE_LOCK_SOURCE" ] || \
    [ ! -x "$PREPUSH_TIP_DRIFT_SCRIPT" ]; then
    echo "❌ pre-push trusted helper bundle is incomplete; refusing push."
    exit 1
fi

echo "🔍 Running pre-push hooks..."

# Test suite runs in pre-commit hook (type checking + linting + import chain).
# Full test:ci with coverage is too slow for pre-push (~120s) and causes
# false positives from coverage exit codes. Run manually: npm run test:ci
echo "✅ Skipping full test suite (covered by pre-commit hooks)"

# ============================================================================
# quickcheck (advisory, 2026-08-23, S12 C4) — scripts/quickcheck.sh
#
# Fast local companion to the heavy gates in this file: impact-scoped pytest
# (via scripts/ci/impact_map.py — the SAME engine the PR lane's test
# selection uses), `prettier --check` on changed files, `actionlint` when
# `.github/workflows/` changed, and an R1 literal '## Adversarial review'
# heading check against the branch's open PR (if any). Exists to name a
# purely mechanical red-CI cause locally in minutes instead of a ~30min CI
# round-trip — see scripts/quickcheck.sh's own header for the full rationale.
#
# ADVISORY ONLY — WARNS, NEVER BLOCKS. `|| true` below is load-bearing under
# this hook's production `sh -e` invocation (see the file-level gotcha notes
# near the top of this file): a bare non-zero exit from quickcheck.sh would
# otherwise abort the ENTIRE hook right here, silently skipping every gate
# below it — exactly the decapitated-guard shape this repo already has scars
# for (W101 family). quickcheck.sh's own exit code is unconditionally 0 by
# design (see its header), so `|| true` is redundant defense-in-depth, not
# the only thing standing between this block and blocking a push.
#
# This block's own success/failure is therefore NEVER read by anything
# downstream in this file — it cannot change what PREPUSH_RUN_BACKEND,
# BACKEND_SUITE_RAN, or the final verdict end up being.
#
# Kill switch: QUICKCHECK_SKIP=1.
# ============================================================================
if [ "${QUICKCHECK_SKIP:-0}" != "1" ] && [ -f "$PREPUSH_TRUST_ROOT/scripts/quickcheck.sh" ] && command -v bash >/dev/null 2>&1; then
    bash "$PREPUSH_TRUST_ROOT/scripts/quickcheck.sh" || true
fi

# ============================================================================
# Path-aware backend-suite gate (2026-07-17, Zero GO)
#
# A PR that never touches the backend should not pay for the 17,384-test,
# 11-32min Python suite below on every single push (measured: 4 pushes for
# one log-rotation-only PR). This block decides, PURELY from the set of
# files changed by the ref(s) actually being pushed, whether the 4-state
# gate below even runs at all. The gate's OWN internal logic (PG states,
# venv guard, DB clone, CI-parity env — all documented in the big comment
# right below this one) is completely UNCHANGED: when this block decides
# "run the backend suite", behavior is byte-identical to before
# path-awareness existed.
#
# The full/skip-backend DECISION lives in scripts/prepush_classify.py — a
# pure, unit-tested (guilt+innocence, scripts/tests/test_prepush_classify.py)
# Python function, deliberately NOT inline bash (cicatrix-superscar.md #3:
# "nessuna guardia mergiata senza un test di innocenza E di colpevolezza" —
# a guard living only as bash conditionals cannot get that test). THIS
# block's only job is git plumbing: read the pre-push stdin protocol
# (`local_ref local_sha remote_ref remote_sha` per line — the documented
# git pre-push hook contract), compute the right diff range per ref, union
# the changed files across every ref in this push, and hand that union to
# the classifier exactly once.
#
# FAIL-CLOSED EVERYWHERE (non-negotiable): any ambiguity — zero ref lines
# read, a malformed stdin line, a failed `git fetch origin main`, a failed
# `git merge-base`/`git diff`, no python3 on PATH, a non-zero classifier
# exit, or classifier stdout that is not EXACTLY "full" or "skip-backend" —
# forces the FULL suite below. Only a clean, explicit "skip-backend"
# verdict skips it. A ref whose local_sha is the all-zero SHA is a branch
# DELETION: it legitimately contributes zero files to the diff and is NOT
# treated as an error.
#
# AMENDED 2026-08-13 (DEFAULT-OFF note further below): this paragraph still
# describes exactly how the classifier VERDICT is computed — that logic is
# untouched. What changed is what a "full"/fail-closed verdict DOES: it no
# longer runs the suite locally by itself. See the DEFAULT-OFF block right
# before `PREPUSH_RUN_BACKEND=0` for why and for the escape hatch.
#
# FRESHNESS (added post-panel-review, same day, GLM 5.2 finding): the
# "new branch" diff range below is computed as `merge-base origin/main
# local_sha`. A LOCAL `origin/main` ref that has not been fetched recently
# is a proxy that can lie about where this branch actually forked
# (cicatrix-superscar.md #9, state-schema/proxy-drift family) — so this
# block runs `git fetch origin main` unconditionally before touching any
# ref, and fails closed to FULL if that fetch fails, rather than silently
# trusting whatever origin/main this checkout last happened to know about.
#
# RENAME SAFETY (verified empirically same day): `git diff --name-only`,
# WITHOUT `--no-renames`, collapses a detected rename to a SINGLE line —
# the destination path only. Reproduced live: renaming a file out of one
# directory into another made the SOURCE path vanish from the diff
# entirely. If the source had been backend-relevant and the destination
# allowlisted, the classifier would never see the backend path — an
# under-match by construction. Every `git diff` below therefore passes
# `--no-renames`, so a rename is always reported as delete+add (BOTH the
# old and new path visible in the union, never just one).
#
# REMOTE SAFETY (round-1 red-team HARDENING-1, 2026-07-18, Codex Sol xhigh
# on PR #2642): every diff range below is computed against `origin/main` —
# but git's documented pre-push hook contract passes the ACTUAL remote
# being pushed to as `$1` (and its URL as `$2`), which this block used to
# ignore entirely. A push to any remote OTHER than `origin` would still
# diff against THIS checkout's `origin/main`, which has no guaranteed
# relationship to that other remote's history — worst case an empty or
# nonsensical diff range, i.e. a false "skip-backend" verdict on a push
# this gate never actually inspected correctly. Fixed: the very first
# check in the computation below is `$1 = origin`; anything else fails
# closed to FULL, loudly, before any diff is even attempted.
#
# Kill switches:
#   PREPUSH_FULL=1        always run the full suite unconditionally,
#                          bypassing this entire block.
#   PREPUSH_PATHAWARE=0   disable path-awareness entirely (same net effect
#                          as PREPUSH_FULL=1). The classifier below still
#                          runs by default either way (diagnostic verdict) —
#                          see the DEFAULT-OFF note right below for what
#                          actually gates local execution now.
# ============================================================================

# ---------------------------------------------------------------------------
# DEFAULT-OFF (2026-08-13, measured on M5 over 88 real push logs captured in
# /tmp/*push*.log across ~2.7 days): the backend suite below used to run
# LOCALLY by default whenever the path-aware classifier's verdict was
# "full". Of those 88 pushes, only 2 (2.3%) were genuine test failures. 26
# (30%) — 9 lock-timeout + 17 SIGTERM-killed — produced NO verdict at all:
# the machine-wide suite lock (below, PREPUSH_SUITE_LOCK_SCRIPT) is
# single-flight per machine with a 4500s timeout, and each lane costs
# ~1h50m end-to-end under contention, so from the third concurrent lane on,
# the failure is arithmetic, not incidental.
#
# CI's `Backend Tests (Python)` required check (.github/workflows/tests.yml)
# is a verified STRICT SUPERSET of what this hook runs: same `backend/tests/`
# base, same `--ignore=backend/tests/e2e`, PLUS --cov, PLUS a
# backend_stability_gate.py step, PLUS REDIS_URL (4 occurrences in
# tests.yml, 0 in this file). No test that runs ONLY locally was found while
# looking. So a genuine regression this local suite would have caught, CI
# catches too, every time — while the 30% zero-verdict tax was pure local
# cost for zero unique safety benefit.
# (2026-08-21: tests.yml used to also list three files this hook never ran —
# tests/test_sentry_lazy_import.py, tests/test_sentry_pii_redaction.py,
# tests/kb/test_politics_hierarchical.py — from the orphan apps/backend-rag/tests/
# tree, which pytest.ini's `testpaths = backend/tests` never collected. That
# tree is deleted; those 3 files moved under backend/tests/, so both this
# hook's `backend/tests/` scope and tests.yml's now collect them the same way.)
#
# Verdict: PREPUSH_RUN_BACKEND now DEFAULTS TO 0 — the suite below is
# opt-in only (PREPUSH_FULL=1 or PREPUSH_PATHAWARE=0, both handled right
# below), never automatic, regardless of what the path-aware classifier
# decides. The classifier, the machine-wide lock, the Postgres schema
# clone, and the honest-verdict guard at the bottom of this file are all
# UNCHANGED and behave exactly as before whenever the suite IS forced —
# only the trigger that used to fire it automatically is gone. A "full" or
# fail-closed classifier verdict below still prints its own diagnostic text
# (it still computes exactly what it always did) but no longer runs pytest
# by itself; only PREPUSH_FULL=1 / PREPUSH_PATHAWARE=0 do that now.
#
# This is a measurement over a SHORT window (2.7 days, opportunistic /tmp
# capture, not a permanent log) — re-measure before treating "CI is a
# strict superset" as an eternal truth, and revisit this default if a
# local-only test is ever added to the suite.
# ---------------------------------------------------------------------------
PREPUSH_RUN_BACKEND=0

# ---------------------------------------------------------------------------
# The pre-push protocol stream, captured ONCE, before any branch below.
#
# It used to be consumed inside the path-aware gate's `else` arm, which meant
# the two bypass branches (PREPUSH_FULL / PREPUSH_PATHAWARE=0) never saw it at
# all. Two readers need it now — that gate, and the tip-drift check at the very
# end of this file — and a stream can only be read once, so it is slurped to a
# file here and both read the FILE. Capturing it unconditionally also means the
# drift check still runs on the bypass paths, which is exactly where a gate is
# most worth having.
PREPUSH_REFS="$(mktemp 2>/dev/null || true)"
if [ -n "$PREPUSH_REFS" ]; then
    cat > "$PREPUSH_REFS" || true
fi

if [ "${PREPUSH_FULL:-0}" = "1" ]; then
    # Explicit set, not a reliance on the ambient default above: since
    # PREPUSH_RUN_BACKEND now defaults to 0 (DEFAULT-OFF note above), this
    # branch is the ONLY thing standing between "PREPUSH_FULL=1" and it
    # silently doing nothing.
    PREPUSH_RUN_BACKEND=1
    echo "🧭 PREPUSH_FULL=1 — path-aware gate bypassed, full suite unconditionally."
elif [ "${PREPUSH_PATHAWARE:-1}" = "0" ]; then
    # Same reasoning as the PREPUSH_FULL=1 branch above — this flag's own
    # documented contract ("same net effect as PREPUSH_FULL=1") requires it.
    PREPUSH_RUN_BACKEND=1
    echo "🧭 PREPUSH_PATHAWARE=0 — path-aware gate disabled, full suite unconditionally."
else
    ZERO_SHA="0000000000000000000000000000000000000000"
    PYTHON_BIN="$(command -v python3 || command -v python || true)"
    REFS_SEEN=0
    DIFF_ERROR=0
    UNION_FILE="$(mktemp 2>/dev/null || true)"

    # HARDENING-1 (round-1 red-team, Sol) — see "REMOTE SAFETY" above. Must
    # be the FIRST check: every branch below trusts `origin/main` as the
    # diff baseline, so a non-origin remote invalidates all of them before
    # mktemp/fetch/diff are even worth attempting.
    if [ "$1" != "origin" ]; then
        echo "⚠️  path-aware gate: pushing to remote '$1' (this gate only trusts 'origin' as the diff baseline) — fail-closed — but DEFAULT-OFF above means it still needs PREPUSH_FULL=1 to actually run locally."
        DIFF_ERROR=1
    elif [ -z "$UNION_FILE" ]; then
        echo "⚠️  path-aware gate: mktemp failed — fail-closed — but DEFAULT-OFF above means it still needs PREPUSH_FULL=1 to actually run locally."
        DIFF_ERROR=1
    elif ! git fetch origin main --quiet >/dev/null 2>&1; then
        # See "FRESHNESS" above. A failed fetch means we cannot vouch for
        # local origin/main's currency, so the new-branch merge-base path
        # below must not be trusted this push — fail closed rather than
        # risk a diff range computed against a stale integration point.
        echo "⚠️  path-aware gate: 'git fetch origin main' failed (offline? auth?) — cannot trust local origin/main freshness — fail-closed — but DEFAULT-OFF above means it still needs PREPUSH_FULL=1 to actually run locally."
        DIFF_ERROR=1
    else
        : > "$UNION_FILE"
        # Reads the pre-push protocol lines captured at the top of this file
        # (they used to be read straight off stdin here; a second reader — the
        # tip-drift check at the end — now needs them too, and a stream serves
        # exactly one reader).
        while read -r local_ref local_sha remote_ref remote_sha; do
            [ -z "$local_ref" ] && continue  # trailing blank line safety
            REFS_SEEN=$((REFS_SEEN + 1))

            # git's pre-push protocol always emits exactly 4 fields; a
            # short/garbled line means we cannot safely compute a diff range.
            if [ -z "$local_sha" ] || [ -z "$remote_sha" ]; then
                DIFF_ERROR=1
                break
            fi

            if [ "$local_sha" = "$ZERO_SHA" ]; then
                # Ref deletion — no local commit to diff, contributes no
                # files. Legitimate (delete-only push), not an error.
                continue
            fi

            # ALWAYS anchor to the merge-base with origin/main — for a brand-new
            # branch AND for one already on the remote. The range is "what this
            # branch contributes that main does not have", i.e. GitHub's own
            # "Files changed" semantics.
            #
            # This used to branch on $remote_sha ("existing branch — diff only the
            # NEW commits since what the remote already has"), and that asymmetry
            # WAS the defect. When a branch merges origin/main in (the normal way
            # to resolve a conflict), `$remote_sha..$local_sha` contains every
            # commit main gained since the last push — so the classifier is handed
            # MAIN's files and attributes them to this push. Measured 2026-07-26 on
            # a two-file diff whose files are BOTH on the allowlist: the classifier
            # reported "11/20 changed file(s) are NOT on the innocent allowlist" and
            # named .gitignore, published_articles.json, escalations_pro.jsonl,
            # scripts/merge_train.py … all of them already merged and already
            # tested. Result: the FULL suite, three times, ~40 min each. Re-cut
            # from main with no merge commit, the same delta passed the gate in
            # seconds. The rule was right; the INPUT lied — W102's shape, here in
            # the pre-push gate instead of in CI.
            #
            # Trade-off, deliberate: on an incremental push to an existing branch
            # this now re-classifies the branch's WHOLE file set rather than just
            # the newest commits. That is strictly more conservative (it can only
            # widen the set, never narrow it), and a branch's own file set is
            # small — whereas the merge case it fixes could pull in hundreds.
            #
            # W101 sibling (2026-07-26): a BARE X="$(...)" assignment takes the
            # substitution's exit status under this wrapper's sh -e, so a failing
            # `git merge-base` (no common ancestor, corrupt local_sha, etc.) would
            # abort the whole hook HERE — before the `[ -z "$RANGE_FROM" ]` check
            # two lines down ever runs, exactly as the already-fixed VERDICT_OUTPUT
            # line below documents. `|| RANGE_FROM=""` makes the failure land IN the
            # variable instead of killing the script, so the existing fail-closed
            # check below still fires and degrades to the FULL suite as designed.
            RANGE_FROM="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || RANGE_FROM=""
            if [ -z "$RANGE_FROM" ]; then
                DIFF_ERROR=1
                break
            fi

            if ! git diff --no-ext-diff --no-renames --name-only "$RANGE_FROM" "$local_sha" >> "$UNION_FILE" 2>/dev/null; then
                DIFF_ERROR=1
                break
            fi
        done < "${PREPUSH_REFS:-/dev/null}"

        # An unreadable capture is indistinguishable from an empty push here,
        # and both must fail closed — which the REFS_SEEN test below already
        # does, since /dev/null yields zero lines.
        [ "$REFS_SEEN" -eq 0 ] && DIFF_ERROR=1
    fi

    if [ "$DIFF_ERROR" = "1" ]; then
        echo "⚠️  path-aware gate: could not safely compute the changed-file diff for this push — fail-closed — but DEFAULT-OFF above means it still needs PREPUSH_FULL=1 to actually run locally."
        [ -n "$UNION_FILE" ] && rm -f "$UNION_FILE"
    elif [ -z "$PYTHON_BIN" ]; then
        echo "⚠️  path-aware gate: no python3/python on PATH to run the classifier — fail-closed — but DEFAULT-OFF above means it still needs PREPUSH_FULL=1 to actually run locally."
        rm -f "$UNION_FILE"
    else
        # Plain command substitution captures ONLY stdout (the machine
        # verdict); the classifier's stderr (loud human-readable banner)
        # flows straight through to this hook's own stderr, unredirected.
        VERDICT_RC=0
        VERDICT_OUTPUT="$("$PYTHON_BIN" "$PREPUSH_CLASSIFIER" < "$UNION_FILE")" || VERDICT_RC=$?
        rm -f "$UNION_FILE"

        if [ "$VERDICT_RC" != "0" ]; then
            echo "⚠️  path-aware gate: classifier exited $VERDICT_RC — this would fail closed to the FULL suite, but DEFAULT-OFF (above) means it does not run locally either way. PREPUSH_FULL=1 to run it."
        elif [ "$VERDICT_OUTPUT" = "skip-backend" ]; then
            PREPUSH_RUN_BACKEND=0
        elif [ "$VERDICT_OUTPUT" != "full" ]; then
            echo "⚠️  path-aware gate: unrecognized classifier output '$VERDICT_OUTPUT' — this would fail closed to the FULL suite, but DEFAULT-OFF (above) means it does not run locally either way. PREPUSH_FULL=1 to run it."
        fi
        # VERDICT_OUTPUT = "full": PREPUSH_RUN_BACKEND stays at its default —
        # 0 since 2026-08-13 (DEFAULT-OFF note above). This branch still
        # computes and prints the classifier's own diagnostic verdict
        # (whose own stderr banner, e.g. "running FULL suite", describes
        # ITS internal reasoning — not a promise that pytest runs locally);
        # only PREPUSH_FULL=1 / PREPUSH_PATHAWARE=0 actually run it now.
    fi
fi

# ============================================================================
# CONSUMER-MAP — deleted/renamed-file live-consumer check (2026-08-21, #4459)
#
# #4459 deleted apps/backend-rag/tests/ (an orphan tree) and went CI-red
# TWICE: two consumers were invisible to a path-prefix search because each
# named the deleted files relative to something OTHER than the deleted path
# — a `cd apps/backend-rag` step in .github/workflows/sonarqube.yml, and a
# bare string inside a Python list literal in
# apps/backend-rag/scripts/backend_stability_gate.py:41. scripts/consumer_map.py
# (invoked here through prepush_classify.py --check-consumers — see that
# file's module docstring "SEPARATE MODE") searches by BASENAME instead
# (cicatrix-superscar.md #3: search the entity a reader actually names, not
# the form of a path), so both shapes are caught before the push leaves this
# machine.
#
# Runs UNCONDITIONALLY — NOT gated by PREPUSH_RUN_BACKEND/DEFAULT-OFF above.
# That flag only controls whether the local pytest suite runs; this check
# answers a different question CI's Backend Tests job never asks (CI only
# ever sees the tree AFTER the deletion, so an elsewhere-living consumer
# just fails late and unrelated-looking — the exact #4459 pattern). Resolves
# python3 independently of PYTHON_BIN (which the path-aware gate above may
# never have set, e.g. under PREPUSH_FULL=1/PREPUSH_PATHAWARE=0) — W108: the
# reporting interpreter must not share the resolution path of whatever it is
# diagnosing. Errexit-immune capture (`|| CM_RC=$?`) — W101, same reason as
# every other captured RC in this file under `sh -e`.
#
# rc 0 = clean (silent, matches the tip-drift happy-path silence rationale
# below). rc 1 = live consumer(s) found — BLOCKS the push, loudly, with the
# table. rc 2+ = could not verify (not this script's kind of git state, no
# python3, missing helper) — WARNS, does NOT block: an environment problem
# here must not wedge a push the way a genuine finding should, the same
# permissive-but-honest posture the PG/venv skips below take.
# Kill switch: PREPUSH_SKIP_CONSUMER_MAP=1.
# ============================================================================
if [ "${PREPUSH_SKIP_CONSUMER_MAP:-0}" != "1" ]; then
    CM_PYTHON="$(command -v python3 || command -v python || true)"
    CM_CLASSIFIER="$PREPUSH_TRUST_ROOT/scripts/prepush_classify.py"
    if [ -n "$CM_PYTHON" ] && [ -f "$CM_CLASSIFIER" ]; then
        CM_RC=0
        CM_OUT="$("$CM_PYTHON" "$CM_CLASSIFIER" --check-consumers --base origin/main 2>&1)" || CM_RC=$?
        case "$CM_RC" in
            0) : ;;
            1)
                CM_COUNT="$(printf '%s\n' "$CM_OUT" | sed -n 's/^CONSUMER_MAP_LIVE_COUNT=//p')"
                echo "❌ consumer-map: ${CM_COUNT:-N} live consumers of deleted/renamed files — push blocked."
                printf '%s\n' "$CM_OUT"
                exit 1
                ;;
            *)
                echo "⚠️  consumer-map check could not verify this push (rc=$CM_RC) — not blocking, but read below:"
                printf '%s\n' "$CM_OUT" | sed 's/^/    /'
                ;;
        esac
    else
        echo "⚠️  consumer-map check skipped — no python3/python on PATH or classifier missing at $CM_CLASSIFIER."
    fi
fi

# Run Python tests — gated on a PROVISIONED local PostgreSQL (CI-parity).
#
# Most backend tests build their schema against DATABASE_URL. With no local PG the
# suite emitted ~141 "Connect call failed (::1, 5432)" errors + ~2min of noise, and
# the old `|| { Continuing }` swallowed it — the gate never gated.
#
# Four gate states (in order):
#   1. PG absent on 127.0.0.1:5432 → clean SKIP (dev without local PG; CI has its own
#      service container so this branch never runs in CI).
#   2. PG present but NOT provisioned (db `nuzantara_test` missing the migrated schema)
#      → SKIP with a "run the one-time bootstrap" pointer. We do NOT block here: a bare
#      `brew services start postgresql@17` must not wedge every push.
#   3. PG provisioned but apps/backend-rag/.venv missing → clean SKIP, checked before
#      touching Postgres at all. A bare `git worktree add` does NOT create the venv
#      symlink the main checkout has; without this gate, `source .venv/bin/activate
#      2>/dev/null` swallows the missing-file error, the `&&` chain aborts mid-subshell,
#      and the hook falls straight into the generic "❌ Python tests FAILED" branch —
#      blocking a push that never ran a single test (L243, 2026-07-16: 4 legitimate
#      pushes blocked this way in one session).
#   4. PG present AND provisioned AND venv present → clone `nuzantara_test` into a
#      throwaway per-push database (state 4 rationale is inline below, where the clone
#      is created), run the REAL suite against the clone with CI-parity env, and a
#      genuine failure BLOCKS the push (exit 1). PRE_PUSH_TEST_DB, if set, overrides
#      which db is used as the TEMPLATE for the clone (still defaults to
#      `nuzantara_test`) — it no longer runs the suite directly against a fixed db.
#
# CI-parity env (mirrors .github/workflows/tests.yml): DATABASE_URL + TEST_DATABASE_URL
# both point at test:test@localhost:5432/<the per-push clone, templated off nuzantara_test>.
# This override is load-bearing — the db conftest default is
# `postgresql://nuzantara@localhost/nuzantara_dev` (role
# `nuzantara`, which does NOT exist locally); CI redirects it via these two env vars and
# so must this hook, else every push fails with `role "nuzantara" does not exist`.
# PYTHONPATH=.:../crm-cell also matches CI (crm-cell is a sibling package).
#
# CI-parity also means CI's ABSENCES: the CI service containers run Postgres+Redis
# but NO Ollama, so live-LLM tests self-skip there via is_ollama_available()
# (e.g. test_live_sealion_golden_rule_null_on_illegible). A dev machine may reach
# a fleet Ollama, which flips those same tests to RUN — making the gate both
# stricter than CI and flaky (2026-07-11: the freshly-armed gate stranded two
# sibling report pushes on that exact live SEA-LION test). OLLAMA_URL points at a
# dead port so the hook gates exactly the test set CI gates — the env name is the
# pydantic mapping of settings.ollama_url (backend/app/core/config.py:127), NOT the
# module-global's name OLLAMA_BASE_URL (probed empirically 2026-07-11: only
# OLLAMA_URL overrides). Same rationale for --ignore=backend/tests/e2e (tests.yml:190).
# NOTE: git resolves the relative hooksPath against the MAIN checkout — worktree
# copies of this file do NOT govern pushes; this fix bites machine-wide only once
# merged to main and pulled there.
#
# F5: keg-only postgresql@17 `pg_isready`/`psql` are NOT on the PATH of this hook's
# non-interactive shell; resolve by absolute path with a `command -v` fallback.
# F8: with PG provisioned, a genuine test failure must BLOCK (exit 1), not "Continuing".
#
# Everything from here through the matching `fi` below runs ONLY when the
# path-aware gate above decided PREPUSH_RUN_BACKEND=1 (full suite). The body
# is intentionally left at its ORIGINAL indentation (not re-indented under
# the new wrapping `if`) — this is a scar-laden, hard-won file and a
# minimal, line-preserving diff is far easier to review byte-for-byte than
# a cosmetically-reindented one. Correctness does not depend on indentation
# in sh/bash.
if [ "$PREPUSH_RUN_BACKEND" = "1" ]; then
echo "🐍 Running Python tests..."
# Honest-verdict bookkeeping (2026-07-27, measured live on Mini). Everything
# below can decide "FULL suite required" and then not run a single test: four
# environment gates skip it (no PG, unprovisioned DB, no venv, clone failed)
# and all four used to fall straight through to the final
# "✅ All pre-push checks passed!" line. Mini's log, verbatim:
#     🧭 6/6 changed file(s) are NOT on the innocent allowlist — running FULL suite
#     🐍 Running Python tests...
#     ⏭️  SKIP Python tests — local PG up but 'nuzantara_test' not provisioned
#     ✅ All pre-push checks passed!
# Its local PG had no `test` role at all, so EVERY push ever made from that
# machine passed a gate that had run zero tests and said so nowhere. This is
# cicatrix-superscar.md family #2 (esiste ≠ armato) on the most-cited gate in
# the fleet: the verdict line is the defect, not the skip. The skips stay
# permissive on purpose — a machine without a test DB must still be able to
# push, and the merge queue re-tests every entry against main — but they may
# no longer be REPORTED as a pass.
BACKEND_SUITE_RAN=0
BACKEND_SUITE_SKIP_REASON=""
PG_BIN="/opt/homebrew/opt/postgresql@17/bin"
PG_ISREADY="$(command -v pg_isready || echo "$PG_BIN/pg_isready")"
PSQL="$(command -v psql || echo "$PG_BIN/psql")"
PRE_PUSH_DB="${PRE_PUSH_TEST_DB:-nuzantara_test}"

# Machine-wide backend-suite lock (2026-07-27, measured: 12 concurrent
# 17k-test suites on M5, load 68, pushes SIGTERM-killed mid-suite — see
# scripts/prepush_suite_lock.sh's own header for the full measurement and
# the primitive-choice rationale). Wraps ONLY the `python -m pytest` call
# below — not the DB clone (already isolated per-push via CLONE_DB=$$, and
# concurrent CREATE DATABASE...TEMPLATE off an unconnected template is fine
# per the comment above it), not the venv/PG gates above, not anything about
# WHICH tests run. At most one backend suite runs per machine at a time;
# everyone else waits with a visible heartbeat, bounded, fail-closed.
# Absolute path: this variable is read INSIDE a `cd apps/backend-rag`
# subshell below, so a relative path here would resolve against the wrong
# directory by the time it's used.
#
# Kill switch: NUZ_PREPUSH_SUITE_LOCK=0 disables the lock entirely (straight
# to unserialized behavior, i.e. today's).
PREPUSH_SUITE_LOCK_SCRIPT="$PREPUSH_SUITE_LOCK_SOURCE"
PREPUSH_SUITE_LOCKFILE="/tmp/nuzantara-prepush-backend-suite.lock"
if ! "$PG_ISREADY" -h 127.0.0.1 -p 5432 -q 2>/dev/null; then
    echo "⏭️  SKIP Python tests — no local PostgreSQL on 127.0.0.1:5432."
    echo "   Install per research/operations/specs/2026-06-12-M5-postgres-local-spec.md to enable the gate."
    BACKEND_SUITE_SKIP_REASON="no local PostgreSQL on 127.0.0.1:5432"
elif [ "$("$PSQL" -h 127.0.0.1 -p 5432 -d "$PRE_PUSH_DB" -tAc "SELECT to_regclass('public.clients') IS NOT NULL;" 2>/dev/null)" != "t" ]; then
    echo "⏭️  SKIP Python tests — local PG up but '$PRE_PUSH_DB' not provisioned (no migrated schema)."
    echo "   One-time bootstrap: cd apps/backend-rag && source .venv/bin/activate && \\"
    echo "     DATABASE_URL=postgresql://test:test@localhost:5432/$PRE_PUSH_DB \\"
    echo "     PYTHONPATH=.:../crm-cell python scripts/ci_bootstrap_schema.py && \\"
    echo "     PYTHONPATH=.:../crm-cell python -m backend.db.migrate apply-all"
    echo "   (see research/operations/specs/2026-06-12-M5-postgres-local-spec.md §AC2)"
    BACKEND_SUITE_SKIP_REASON="'$PRE_PUSH_DB' not provisioned on the local PG"
elif [ ! -f apps/backend-rag/.venv/bin/activate ]; then
    echo "⏭️  SKIP Python tests — worktree has no apps/backend-rag/.venv (bare 'git worktree add' doesn't create it)."
    echo "   Fix: symlink it from the main checkout, or create the worktree via scripts/agent_start.py."
    echo "   CI remains the real gate for this push."
    BACKEND_SUITE_SKIP_REASON="worktree has no apps/backend-rag/.venv"
else
    # Isolated DB clone per push (2026-07-16). Under ~10 concurrent agent pushes,
    # the suite used to run straight against the shared "$PRE_PUSH_DB" — every
    # push's schema-setup/teardown collided with every other's, producing
    # "deadlock detected" / "relation does not exist" FALSE failures that
    # blocked legitimate pushes. The escape hatch people reached for
    # (PRE_PUSH_TEST_DB=<unprovisioned>) is a blunt total-SKIP of the gate, not
    # a fix. Cloning gives every push its own throwaway schema, so the full
    # suite + CI-parity env stay exactly as strict as before — only the
    # contention is gone.
    #
    # CLONE_DB is unique per push (shell PID, $$, PLUS a random suffix — see
    # #60 below), so concurrent pushes never collide. `CREATE DATABASE ...
    # TEMPLATE x` fails if any session is CONNECTED to x — the suite only
    # ever talks to CLONE_DB, never "$PRE_PUSH_DB", so the template stays
    # connection-free during normal operation; the bounded retry below only
    # guards a transient connection (e.g. someone mid-bootstrap on the base
    # db). Concurrent CREATE...TEMPLATE off the SAME un-connected template is
    # fine — Postgres allows N simultaneous clones, that's the whole point.
    #
    # #60 (2026-07-27): PID alone is NOT unique across a machine's uptime —
    # PIDs recycle. Measured live: 15 stranded nuzantara_test_run_<PID>
    # databases on disk (561 MB), left behind by crashed/killed pushes whose
    # EXIT trap never fired (SIGKILL is untrappable) or whose cleanup itself
    # hung (a plain DROP DATABASE against a saturated Postgres can stall
    # minutes on this box — see the sibling finding on synchronous waits
    # under load). When a NEW push's $$ happens to recycle onto a STRANDED
    # clone's old PID, the CREATE loop below fails 3/3 (the name already
    # exists) with NO exit 1 — the entire backend suite silently never runs,
    # and the push succeeds anyway. Same cluster-scope-collision shape as
    # apps/backend-rag/backend/tests/services/visa_engine/test_activation_writer.py's
    # ROLE fix (`uuid.uuid4().hex[:10]`, whose own comment names this exact
    # database case as still being on $$) — cured here the same way, PID
    # kept for human-readable debugging, random suffix for actual uniqueness.
    CLONE_DB="nuzantara_test_run_${$}_${RANDOM}"
    CLONE_CREATED=0
    cleanup_clone() {
        if [ "$CLONE_CREATED" = "1" ]; then
            "$PSQL" -h 127.0.0.1 -p 5432 -d postgres -tAc "DROP DATABASE IF EXISTS \"$CLONE_DB\" WITH (FORCE);" >/dev/null 2>&1
        fi
    }
    # Fires on normal exit, a genuine test failure (`exit 1` below), AND a
    # killed/interrupted push (SIGINT/SIGTERM) — a crashed push must never
    # leak a clone DB (same stale-resource class as the DLQ/worktree scars;
    # see cicatrix-superscar.md #2/#5). DROP ... IF EXISTS is idempotent, so
    # this firing more than once (e.g. once from the failure branch's `exit 1`
    # and again from the EXIT trap it triggers) is harmless.
    trap cleanup_clone EXIT INT TERM
    # The clone must inherit the TEMPLATE's owner, not the cloner's identity.
    # Since PG15 `public` is owned by the pseudo-role pg_database_owner, which
    # resolves to whoever owns the database. CREATE DATABASE re-parents the
    # clone to the creating role — the OS user, `balizero` on M5 — so a template
    # owned by `test` silently loses test's CREATE on public inside the clone:
    # every schema-building test then dies with "permission denied for schema
    # public" and drags a cascade of "relation ... does not exist" behind it
    # (measured 2026-07-16: 39 failed + 79 errors of 17339, blocking the push).
    # Table-level ownership IS copied by the clone; only this schema privilege,
    # held implicitly through ownership rather than by an explicit GRANT,
    # evaporates. The bug stayed latent from #2489 until nuzantara_test happened
    # to be re-created with owner=test — while template-owner == cloner nothing
    # showed. Deriving the owner keeps the clone faithful whoever pushes.
    # Same bare-assignment shape as the two fixed above (W101 family). Not
    # currently exploitable — the pipeline's exit status is `tr`'s, and `tr`
    # with these fixed, valid arguments cannot itself fail — but that safety
    # is INCIDENTAL to psql's success, not designed, and the `if [ -n ... ]`
    # two lines down already documents "unreadable owner must not wedge the
    # push" as the intent. Hardening removes the reliance on tr's behaviour
    # rather than the documented `[ -n ]` check ever actually doing the job.
    TEMPLATE_OWNER="$("$PSQL" -h 127.0.0.1 -p 5432 -d postgres -tAc \
        "SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = '$PRE_PUSH_DB';" 2>/dev/null | tr -d '[:space:]')" || TEMPLATE_OWNER=""
    if [ -n "$TEMPLATE_OWNER" ]; then
        OWNER_CLAUSE=" OWNER \"$TEMPLATE_OWNER\""
    else
        # Unreadable owner must not wedge the push: fall back to the old
        # behaviour (clone owned by the cloner) rather than refusing to clone.
        OWNER_CLAUSE=""
    fi
    # #60 (2026-07-27): defensive pre-drop, belt-and-braces alongside the
    # random suffix above. Even with a random name this makes the CREATE
    # loop's failure mean what its message says ("template busy") rather
    # than silently meaning "a stranded clone already had this exact name" —
    # IF EXISTS makes this a no-op on the (now near-impossible) common case.
    "$PSQL" -h 127.0.0.1 -p 5432 -d postgres -tAc "DROP DATABASE IF EXISTS \"$CLONE_DB\" WITH (FORCE);" >/dev/null 2>&1
    CREATE_OK=0
    ATTEMPT=1
    while [ "$ATTEMPT" -le 3 ]; do
        if "$PSQL" -h 127.0.0.1 -p 5432 -d postgres -tAc "CREATE DATABASE \"$CLONE_DB\" TEMPLATE \"$PRE_PUSH_DB\"$OWNER_CLAUSE;" >/dev/null 2>&1; then
            CREATE_OK=1
            CLONE_CREATED=1
            break
        fi
        ATTEMPT=$((ATTEMPT + 1))
        sleep 2
    done
    if [ "$CREATE_OK" != "1" ]; then
        # #60: this message used to say "(template busy?)" whether the cause
        # was a transient connection OR a stranded clone silently blocking
        # every future push under that name — a genuinely different failure
        # needed a genuinely different sentence to be diagnosable. With the
        # random suffix + defensive drop above, a name COLLISION is now
        # (near-)impossible, so a failure here is more likely to be the
        # template genuinely busy, a permissions issue, or Postgres itself
        # under memory/IO pressure. Still a SKIP, never a block (dev machines
        # without a healthy local PG must keep degrading gracefully) — but
        # the message now says so, instead of pointing at the wrong cause.
        echo "⏭️  SKIP Python tests — could not create clone '$CLONE_DB' from template '$PRE_PUSH_DB' after 3 attempts + defensive drop (template busy, permissions, or PG under load — not a stranded-name collision, that class is now handled above)."
        BACKEND_SUITE_SKIP_REASON="could not clone '$PRE_PUSH_DB' into a throwaway test DB"
    else
        # #45 (2026-07-26): the OLD form here was `elif ! ( subshell ); then FAILED; fi`
        # — a bare boolean negation that collapses EVERY non-zero exit into one
        # branch, unconditionally printed as "Python tests FAILED". Measured
        # (cache-untrack, same night): a push ran clean through 97% of the suite
        # (dots and skips only, ZERO `F` anywhere) then took `Terminated: 15`
        # (SIGTERM) with 3% left — an external kill, not a failing assertion —
        # and this branch still printed "❌ Python tests FAILED — push blocked",
        # blaming the diff for an infrastructure event. Any lane seeing that line
        # had grounds to hunt a regression that does not exist. Same family as
        # W104 (judge the REPLY, not the exit code) and W97 (a pipe masks the
        # RC): the exit code IS the reply here, but a bare `!(...)` throws away
        # the one bit of it (128+N = signal-terminated) that would have told the
        # truth. Capturing the raw code and classifying it three ways is the fix
        # — a synthetic exit code would test the arithmetic below, not the bug,
        # so guilt/innocence in scripts/tests/test_prepush_failclosed.sh use a
        # REAL `kill -TERM` on a real child process for the signal case.
        #
        # #45 round 2: this hook runs live under `sh -e` (production invocation,
        # confirmed in the process table). Under `-e`, a BARE compound command
        # aborts the shell on non-zero before the next line ever runs — only a
        # command in a TESTED context (`if`, `!`, `&&`, `||`) is exempt. The
        # first cut of this fix removed the `!` that made the old code -e-safe
        # and left the subshell bare, so `TEST_RC=$?` below never executed: the
        # three-way classification was correct and completely unreachable.
        # Fixed the same way line 319's TEMPLATE_OWNER assignment already is —
        # `|| TEST_RC=$?` puts the subshell in a tested context, so `-e` is
        # exempt and TEST_RC still gets the real code (verified: exit 3 -> 3,
        # a real `kill -TERM` on a real child -> 143).
        #
        # TWO failure modes guarded right here — do not "fix" one and
        # reopen the other: (1) an external SIGTERM misreported as "tests
        # FAILED" (round 1, the 3-way classification below), (2) that
        # classification being unreachable under `sh -e` (round 2, this
        # `|| TEST_RC=$?` guard). Reference: scripts/tests/test_prepush_failclosed.sh.
        #
        # INTAKE_TEST_DSN (added 2026-07-27) — the third env var below. CI has
        # exported it since it was introduced (.github/workflows/tests.yml, whose
        # comment says pointing it at the disposable CI database "instead of their
        # local-dev fallback (nuzantara_dev)" un-skipped 50 tests); this hook never
        # did. backend/tests/services/intake/test_intake_writer.py:34 reads
        # `os.environ.get("INTAKE_TEST_DSN", "postgresql://localhost:5432/nuzantara_dev")`
        # — a default that fails OPEN onto the machine's SHARED dev database rather
        # than skipping. Measured on Pro (2026-07-27): 12,408 client rows there, 9 of
        # them created in 6 hours by these tests' real-commit cases, and the file's own
        # `assert after == before, "CRM mutated!"` guard seeing writes it did not cause
        # — it rejected a push whose diff touched only this hook, a requirements file
        # and two files under scripts/tests/. Exporting the per-push clone here makes
        # the local gate match CI exactly, and the shared dev DB stops being test
        # scratch space.
        #
        # NOT "nothing skipped" — an earlier draft of this comment said that and it
        # was false. `test_drive_autocreate_apply.py` carries an attestation guard
        # (its lines 62-89): 7 of its cases refuse any database that is not the
        # "approved local book" nuzantara_dev, so pointing this variable at the clone
        # makes them SKIP. That is deliberate on the test's side and it is what CI
        # has always done — those 7 skip there too, since tests.yml points the same
        # variable at nuzantara_test. So this change does not lose coverage relative
        # to the gate that decides the merge; it makes the local gate stop being a
        # third, more permissive one. The real gap it exposes — 7 attested-entrypoint
        # cases that now run on NO gate anywhere, whose only previous home was
        # Pro/M5 against real client rows — pre-dates this change and is filed
        # separately. Fixing it means giving the attestation an approved DISPOSABLE
        # book, never pointing these tests back at production data.
        TEST_RC=0
        ( cd apps/backend-rag \
            && rm -rf .pytest_cache backend/.pytest_cache \
            && source .venv/bin/activate 2>/dev/null \
            && DATABASE_URL="postgresql://test:test@localhost:5432/$CLONE_DB" \
               TEST_DATABASE_URL="postgresql://test:test@localhost:5432/$CLONE_DB" \
               INTAKE_TEST_DSN="postgresql://test:test@localhost:5432/$CLONE_DB" \
               JWT_SECRET_KEY="${JWT_SECRET_KEY:-test_jwt_secret_key_for_testing_only_min_32_chars_long}" \
               API_KEYS="${API_KEYS:-test_api_key_1,test_api_key_2}" \
               OLLAMA_URL="http://127.0.0.1:9" \
               PYTHONPATH=.:../crm-cell \
               "$PREPUSH_SUITE_LOCK_SCRIPT" "$PREPUSH_SUITE_LOCKFILE" \
               python -m pytest backend/tests/ --ignore=backend/tests/e2e --tb=short -q ) || TEST_RC=$?
        if [ "$TEST_RC" -eq 0 ]; then
            # The ONLY place the suite genuinely ran to a pass. Every other
            # path out of this block either exits 1 or leaves a skip reason.
            BACKEND_SUITE_RAN=1
        elif [ "$TEST_RC" -eq 75 ]; then
            # 75 = EX_TEMPFAIL, returned by prepush_suite_lock.sh ONLY when it
            # never acquired the machine lock. The wrapped pytest was not even
            # spawned, so there is nothing to reproduce and nothing to blame.
            #
            # Before this branch existed the timeout exited 1 — pytest's own
            # "tests failed" — and fell through to the generic branch below,
            # which printed "❌ Python tests FAILED" plus a reproduce command
            # for a suite that never ran. Seen twice on 2026-07-29 on a
            # 9-waiter M5. Third instance of the same disease as #45 and W104:
            # the exit code is the reply, and two replies sharing one value
            # means the verdict names something it never measured.
            echo "⚠️  Backend suite NEVER RAN — this machine's suite lock was not acquired. NO VERDICT, push blocked."
            echo "   Nothing here is a statement about your diff: no test judged it. Do NOT hunt a regression,"
            echo "   and do NOT print a reproduce command — there is no failure to reproduce."
            echo "   Retry when the queue drains. The wrapper above prints who holds the lock and how long it has"
            echo "   actually been alive; judge staleness from THAT, not from how long you personally waited."
            exit 1
        elif [ "$TEST_RC" -ge 128 ]; then
            TEST_SIGNAL=$((TEST_RC - 128))
            echo "⚠️  Python test run TERMINATED by signal $TEST_SIGNAL — NO VERDICT, push blocked pending re-run."
            echo "   This is NOT a test failure: something external killed the process (resource"
            echo "   contention, timeout, manual kill) before it could report pass or fail. Do NOT"
            echo "   go hunting for a regression in this diff — re-run the push once load clears."
            exit 1
        else
            echo "❌ Python tests FAILED — push blocked."
            echo "   Reproduce (against the persistent base db, not the dropped clone): \\"
            echo "     cd apps/backend-rag && source .venv/bin/activate && \\"
            echo "     DATABASE_URL=postgresql://test:test@localhost:5432/$PRE_PUSH_DB \\"
            echo "     TEST_DATABASE_URL=postgresql://test:test@localhost:5432/$PRE_PUSH_DB \\"
            # INTAKE_TEST_DSN belongs in the printed command for the same reason it
            # belongs in the run above, and leaving it out is worse here than
            # anywhere: these three env vars are COMMAND-SCOPED, so nothing survives
            # into the shell of whoever copies this line. Without it,
            # test_intake_review.py / test_intake_writer.py /
            # test_drive_autocreate_apply.py fall back to their default
            # `postgresql://localhost:5432/nuzantara_dev` — the machine's SHARED dev
            # database, 12,408 client rows on Pro — and the reproduce step then
            # WRITES there while hunting a failure. Printing the isolated DSN in the
            # run and omitting it from the reproduction would have reintroduced the
            # exact defect this diff exists to close, in the help text.
            echo "     INTAKE_TEST_DSN=postgresql://test:test@localhost:5432/$PRE_PUSH_DB \\"
            echo "     OLLAMA_URL=http://127.0.0.1:9 \\"
            echo "     PYTHONPATH=.:../crm-cell pytest backend/tests/ --ignore=backend/tests/e2e"
            exit 1
        fi
    fi
fi
else
    # Covers every way PREPUSH_RUN_BACKEND can still be 0 here (DEFAULT-OFF,
    # 2026-08-13, top of this file) — a clean path-aware "skip-backend"
    # verdict, a "full" verdict, or a fail-closed/ambiguous classifier
    # outcome all land in this same branch now, so the message must not
    # claim a specific one of them (it used to, and would have been wrong
    # for the other two).
    echo "⏭️  Backend suite SKIPPED locally by default (PREPUSH_RUN_BACKEND=0, see 2026-08-13 DEFAULT-OFF"
    echo "   note near the top of this file)."
    echo "   The required CI check 'Backend Tests (Python)' (.github/workflows/tests.yml) is the real"
    echo "   gate — it always runs the full suite on the PR. Force it locally too: PREPUSH_FULL=1 git push"
fi
# Note: Coverage check removed from pre-push (current coverage ~0.67%, target 80% is long-term goal)
# To check coverage manually: pytest tests/ --cov=. --cov-report=term-missing --cov-fail-under=80

# Check for task-marker comments in new code.
echo "📋 Checking for task-marker comments..."
MARKER_PATTERN='TO''DO|FIX''ME|HA''CK|BU''G'
if git diff --no-ext-diff --unified=0 origin/HEAD...HEAD 2>/dev/null \
    | grep -E '^\+[^+]' \
    | grep -E "$MARKER_PATTERN" >/dev/null 2>&1; then
    echo "⚠️  WARNING: Found task-marker comments in new code."
    echo "   Please consider creating GitHub issues for these items."
    echo "   Use issue links for intentionally retained markers."
fi

# The verdict must describe what actually ran. If the path-aware gate decided
# the backend suite was REQUIRED for this diff and no suite ever executed, this
# push is UNVERIFIED — not passing. Deliberately not fail-closed: blocking here
# would wall off every machine whose local PG isn't provisioned (Mini today),
# and the merge queue re-tests every entry against main anyway. What changes is
# only the claim, which is the part that was false.
# Defaults on both vars: the path-aware SKIP branch never enters the block that
# initialises them, and this hook runs under `sh -e`.
# ---------------------------------------------------------------------------
# TIP-DRIFT — did the branch move while everything above was running?
#
# Everything above judged the sha git handed this hook on stdin. If a commit
# landed on the branch in the meantime, that verdict describes a DIFFERENT tree
# than the one about to be sent — measured 2026-07-28: the hook validated
# f3bf5632, GitHub recorded a single PushEvent 418d187c -> d45c116e, and git's
# own summary line still named f3bf5632. Rationale, evidence and the reason
# this one REFUSES (unlike the softer verdict below it) are in the checker.
#
# Errexit-immune capture on purpose: a bare `TIP_RC=$(...)` under this hook's
# `sh -e` would abort here on the very exit code it exists to read — W101, the
# scar whose fourth instance shipped the same week.
if [ -n "${PREPUSH_REFS:-}" ] && [ -x "$PREPUSH_TIP_DRIFT_SCRIPT" ]; then
    TIP_RC=0
    TIP_OUT=$(sh "$PREPUSH_TIP_DRIFT_SCRIPT" "$PREPUSH_REFS" 2>&1) || TIP_RC=$?
    case "$TIP_RC" in
        0)
            # Print the receipt. Measured on this check's OWN first real push:
            # it passed and emitted nothing, so 238KB of push log contained no
            # evidence it had run at all — a hook without this block produces
            # the identical silence. The rc=2 branch below already refuses to
            # be silent for exactly this reason; the same argument applies to
            # the happy path, where it is easier to forget and cheaper to fix.
            printf '%s\n' "$TIP_OUT"
            ;;
        1)
            printf '%s\n' "$TIP_OUT"
            rm -f "$PREPUSH_REFS"
            exit 1
            ;;
        *)
            # CANNOT-VERIFY (deletion-only push, vanished ref, unreadable
            # capture). Not drift, so it must not block — but it must not be
            # silent either: an unverified push that reads like a verified one
            # is the whole failure mode this check exists for.
            echo "⚠️  tip-drift check could not verify this push (rc=$TIP_RC):"
            printf '%s\n' "$TIP_OUT" | sed 's/^/    /'
            ;;
    esac
fi
[ -n "${PREPUSH_REFS:-}" ] && rm -f "$PREPUSH_REFS"

if [ "$PREPUSH_RUN_BACKEND" = "1" ] && [ "${BACKEND_SUITE_RAN:-0}" != "1" ]; then
    echo "⚠️  PUSH NOT VERIFIED LOCALLY — the backend suite was REQUIRED for this diff but never ran"
    echo "    (${BACKEND_SUITE_SKIP_REASON:-reason not recorded})."
    echo "    This is NOT a passing verdict: no test judged this diff on this machine."
    echo "    Nothing has judged it yet: CI on the PR, and then the merge queue re-testing"
    echo "    the entry against main, are the gates that still have to. Do not read this as green."
    echo "    To make this machine's gate real, fix the cause above."
else
    echo "✅ All pre-push checks passed!"
fi
