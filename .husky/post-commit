#!/bin/sh
python3 scripts/docs_sync.py --quiet 2>/dev/null &

# Bidirectional git sync between Pro and Mini
# Best-effort and observable. The script never fails the commit.
if [ -f scripts/pro-mini-git-sync-hook.sh ]; then
    /bin/sh scripts/pro-mini-git-sync-hook.sh >/dev/null 2>&1 || true
fi

# Organism adoption trigger — fire-and-forget, must NEVER block commit
PYTHONPATH="$(git rev-parse --show-toplevel)/apps/organism" python3 -m organism.post_commit_hook 2>/dev/null || true
