#!/bin/sh
python3 scripts/docs_sync.py --quiet 2>/dev/null &

# Bidirectional git sync between Pro and Mini
# This file is git-tracked and identical on both machines.
# The hostname check determines which direction to sync.
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$BRANCH" = "main" ]; then
    if [ "$(hostname)" = "Nuzantara" ]; then
        # Pro → Mini: tell Mini to pull from Pro
        (ssh -o ConnectTimeout=5 -o BatchMode=yes mini \
          "cd ~/Desktop/nuzantara && git stash -q 2>/dev/null; git pull pro main --ff-only 2>&1; git stash pop -q 2>/dev/null || true" \
          >> ~/.openclaw/logs/git-sync.log 2>&1) &
    elif [ "$(hostname)" = "Mini-Pro2" ]; then
        # Mini → Pro: push directly to Pro
        (git push pro main >> ~/.openclaw/logs/git-sync.log 2>&1) &
    fi
fi

# Organism adoption trigger — fire-and-forget, must NEVER block commit
PYTHONPATH="$(git rev-parse --show-toplevel)/apps/organism" python3 -m organism.post_commit_hook 2>/dev/null || true
