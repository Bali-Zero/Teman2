# Dropbox Migration Configuration
# Copy this file to .env and fill in your values

# Dropbox API Token
# Get from: https://www.dropbox.com/developers/apps
DROPBOX_API_TOKEN=your_dropbox_token_here

# Google Drive Credentials
# Download from: https://console.cloud.google.com/
GOOGLE_DRIVE_CREDENTIALS_PATH=/path/to/credentials.json

# Database Connection
# Same as your Nuzantara backend database
DATABASE_URL=postgresql://user:password@host:5432/nuzantara

# Migration Settings
DROPBOX_WATCH_PATH=/path/to/dropbox/root
GDRIVE_DESTINATION_FOLDER=Bali Zero Clients

# Optional Settings
AUTO_CREATE_CLIENTS=false
BATCH_SIZE=5
CHECK_INTERVAL_SECONDS=60
ENABLE_OCR=true
PARALLEL_UPLOADS=3
