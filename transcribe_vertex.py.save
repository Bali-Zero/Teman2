import vertexai
from vertexai.generative_models import GenerativeModel, Part
import os
import json

# --- CONFIGURAZIONE ---
# 1. Credenziali
os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = "credentials/nuzantara-key.json" 

# 2. Configura il progetto Vertex
PROJECT_ID = "nuzantara"
LOCATION = "global"
MODEL_NAME = "gemini-1.5-pro-001" 

# 3. File Input (Percorso Assoluto Sicuro)
PDF_PATH = "/Users/antonellosiano/Desktop/lampiran/2.3 Lampiran I.C PP Nomor 28 Tahun 2025 (I.C.1-182) (1).pdf"
OUTPUT_FILE = "KBLI_Full_Dataset.json"

def transcribe_pdf():
    print(f"🚀 Inizializzazione Vertex AI ({PROJECT_ID})...")
    try:
        vertexai.init(project=PROJECT_ID, location=LOCATION)
    except Exception as e:
        print(f"❌ Errore Init: {e}")
        return

    print(f"📄 Verifica file: {PDF_PATH}")
    if not os.path.exists(PDF_PATH):
        print(f"❌ ERRORE: Il file non esiste. Controlla il percorso.")
        return

    try:
        model = GenerativeModel(MODEL_NAME)
            pdf_data = f.read()
        pdf_part = Part.from_data(data=pdf_data, mime_type="application/pdf")
    except Exception as e:
        print(f"❌ Errore caricamento: {e}")
        return

    # Prompt
    prompt = """
    Sei un Data Engineer. Analizza il PDF (Lampiran I.C).
    OBIETTIVO: Estrarre TUTTI i record in JSON.
    
    REGOLE:
    1. Trascrizione INTEGRALE di 'Persyaratan', 'Kewajiban', 'Kewenangan'.
    2. Unisci parole spezzate (es. "pembangun- an" -> embangunan").
    3. Row Detection: Ogni numero in colonna "No" è un record.
    4. KBLI: Se manca, usa quello della riga precedente.
    
    SCHEMA JSON:
    [
      {
        "no": "Numero",
        "kode_kbli": "Codice",
        "judul_kbli": "Titolo",
        "ruang_lingkup": "Ambito",
        "tingkat_risiko": "Rischio",
        "perizinan": "Permessi",
        "jangka_waktu": "Tempistiche",
       "persyaratan": ["Req 1", "Req 2"],
        "kewajiban": ["Obb 1", "Obb 2"],
        "kewenangan": "Autorità"
      }
    ]
    Restituisci SOLO JSON.
    """

    print("⚡️ Invio a Gemini (Attendi)...")
    try:
        response = model.generate_content(
            [pdf_part, prompt],
            generation_config={"max_output_tokens": 8192, "temperature": 0.0, "response_mime_type": "application/json"}
        )
    except Exception as e:
        print(f"❌ Errore API: {e}")
        return

    print("✅ Risposta ricevuta! Salvataggio...")
    try:
        clean = response.text.replace("```json", "").replace().strip()
        data = json.loads(clean)
        with open(OUTPUT_FILE, "w", encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        print(f"🎉 Fatto! File: {OUTPUT_FILE}")
        print(f"📊 Record: {len(data)}")
    except Exception as e:
        print(f"❌ Errore salvataggio: {e}")
        with open("error_log.txt", "w") as f: f.write(response.text)

if __name__ == "__main__":
    transcribe_pdf()
