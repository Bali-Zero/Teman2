{
  "$defs": {
    "ActionItemRef": {
      "additionalProperties": false,
      "description": "``{action_item_id, object_hash}`` -- the typed pointer used everywhere\nthe chain names one exact ``ActionItem`` revision (never a bare family\nID, per primitive ``exact_object_ref``'s rule generalized to this kind).",
      "properties": {
        "action_item_id": {
          "format": "uuid",
          "title": "Action Item Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        }
      },
      "required": ["action_item_id", "object_hash"],
      "title": "ActionItemRef",
      "type": "object"
    },
    "AuthorityRequired": {
      "additionalProperties": false,
      "properties": {
        "expires_after_seconds": {
          "exclusiveMinimum": 0,
          "title": "Expires After Seconds",
          "type": "integer"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": ["role", "scope", "expires_after_seconds"],
      "title": "AuthorityRequired",
      "type": "object"
    },
    "ExactObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_kind": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Object Kind",
          "type": "string"
        }
      },
      "required": ["object_kind", "object_id", "object_hash"],
      "title": "ExactObjectRef",
      "type": "object"
    },
    "ExtensionValue": {
      "additionalProperties": false,
      "properties": {
        "extension_version": {
          "title": "Extension Version",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": ["extension_version", "payload"],
      "title": "ExtensionValue",
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowRunRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["input_hashes"],
      "title": "Lineage",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "title": "Producer",
      "type": "object"
    },
    "RequestedActionSpecRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "requested_action_spec_id": {
          "format": "uuid",
          "title": "Requested Action Spec Id",
          "type": "string"
        }
      },
      "required": ["requested_action_spec_id", "object_hash"],
      "title": "RequestedActionSpecRef",
      "type": "object"
    },
    "Retention": {
      "additionalProperties": false,
      "properties": {
        "legal_hold": {
          "title": "Legal Hold",
          "type": "boolean"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        },
        "retention_class": {
          "enum": ["public_record", "operational", "audit", "restricted"],
          "title": "Retention Class",
          "type": "string"
        },
        "rights_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Expires At"
        }
      },
      "required": ["retention_class", "legal_hold"],
      "title": "Retention",
      "type": "object"
    },
    "RiskClass": {
      "enum": ["green", "amber", "red"],
      "title": "RiskClass",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted_osint",
        "client_pii"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/ExactObjectRef"
        },
        "surface": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "system": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "System",
          "type": "string"
        }
      },
      "required": ["system", "object_ref"],
      "title": "Target",
      "type": "object"
    },
    "WorkflowRunRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "workflow_run_id": {
          "format": "uuid",
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": ["workflow_run_id", "object_hash"],
      "title": "WorkflowRunRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_intent_id": {
      "format": "uuid",
      "title": "Action Intent Id",
      "type": "string"
    },
    "action_item_ref": {
      "$ref": "#/$defs/ActionItemRef"
    },
    "action_type": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Action Type",
      "type": "string"
    },
    "arguments_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Arguments Hash",
      "type": "string"
    },
    "arguments_ref": {
      "minLength": 1,
      "title": "Arguments Ref",
      "type": "string"
    },
    "authority_required": {
      "$ref": "#/$defs/AuthorityRequired"
    },
    "contract_version": {
      "const": "research-os/v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Created At",
      "type": "string"
    },
    "expected_outcome_types": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
        "type": "string"
      },
      "title": "Expected Outcome Types",
      "type": "array"
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ExtensionValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extensions"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_revision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Revision Hash",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Object Hash",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "requested_action_spec_ref": {
      "$ref": "#/$defs/RequestedActionSpecRef"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "tenant": {
      "const": "bali-zero",
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "action_intent_id",
    "contract_version",
    "tenant",
    "action_item_ref",
    "requested_action_spec_ref",
    "action_type",
    "target",
    "arguments_ref",
    "arguments_hash",
    "input_revision_hash",
    "risk_class",
    "sensitivity",
    "authority_required",
    "idempotency_key",
    "expected_outcome_types",
    "created_at",
    "producer",
    "lineage",
    "retention",
    "object_hash"
  ],
  "title": "ActionIntent",
  "type": "object"
}
