{
  "$defs": {
    "ActorOrExecutor": {
      "additionalProperties": false,
      "properties": {
        "actor_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        }
      },
      "required": ["producer"],
      "title": "ActorOrExecutor",
      "type": "object"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "key_version": {
          "minLength": 1,
          "title": "Key Version",
          "type": "string"
        },
        "pseudonym": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pseudonym",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "approval",
            "verification",
            "queue_decision",
            "assignment",
            "execution",
            "audit"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "scheme": {
          "const": "hmac-sha256",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": ["scheme", "key_version", "purpose", "pseudonym"],
      "title": "ActorRef",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        }
      },
      "required": ["risk_class", "sensitivity"],
      "title": "Classification",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "effect_type": {
          "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
          "title": "Effect Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EffectStatus"
        },
        "target_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["effect_type", "status"],
      "title": "Effect",
      "type": "object"
    },
    "EffectStatus": {
      "enum": ["confirmed", "not_observed", "failed", "unknown"],
      "title": "EffectStatus",
      "type": "string"
    },
    "ExactObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_kind": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Object Kind",
          "type": "string"
        }
      },
      "required": ["object_kind", "object_id", "object_hash"],
      "title": "ExactObjectRef",
      "type": "object"
    },
    "ExecutionAttemptRef": {
      "additionalProperties": false,
      "properties": {
        "execution_attempt_id": {
          "format": "uuid",
          "title": "Execution Attempt Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        }
      },
      "required": ["execution_attempt_id", "object_hash"],
      "title": "ExecutionAttemptRef",
      "type": "object"
    },
    "ExecutionTerminalOutcome": {
      "enum": ["succeeded", "failed", "cancelled", "unknown"],
      "title": "ExecutionTerminalOutcome",
      "type": "string"
    },
    "ExtensionValue": {
      "additionalProperties": false,
      "properties": {
        "extension_version": {
          "title": "Extension Version",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": ["extension_version", "payload"],
      "title": "ExtensionValue",
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowRunRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["input_hashes"],
      "title": "Lineage",
      "type": "object"
    },
    "OperationalReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "operational_receipt_id": {
          "format": "uuid",
          "title": "Operational Receipt Id",
          "type": "string"
        }
      },
      "required": ["operational_receipt_id", "object_hash"],
      "title": "OperationalReceiptRef",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "title": "Producer",
      "type": "object"
    },
    "Reconciliation": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ExactObjectRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ReconciliationState"
        }
      },
      "required": ["state", "evidence_refs"],
      "title": "Reconciliation",
      "type": "object"
    },
    "ReconciliationState": {
      "enum": ["pending", "confirmed", "mismatch", "not_applicable"],
      "title": "ReconciliationState",
      "type": "string"
    },
    "Retention": {
      "additionalProperties": false,
      "properties": {
        "legal_hold": {
          "title": "Legal Hold",
          "type": "boolean"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        },
        "retention_class": {
          "enum": ["public_record", "operational", "audit", "restricted"],
          "title": "Retention Class",
          "type": "string"
        },
        "rights_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Expires At"
        }
      },
      "required": ["retention_class", "legal_hold"],
      "title": "Retention",
      "type": "object"
    },
    "RiskClass": {
      "enum": ["green", "amber", "red"],
      "title": "RiskClass",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted_osint",
        "client_pii"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "WorkflowRunRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "workflow_run_id": {
          "format": "uuid",
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": ["workflow_run_id", "object_hash"],
      "title": "WorkflowRunRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_or_executor": {
      "$ref": "#/$defs/ActorOrExecutor"
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ExactObjectRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "contract_version": {
      "const": "research-os/v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "effects": {
      "items": {
        "$ref": "#/$defs/Effect"
      },
      "title": "Effects",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ExactObjectRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_attempt_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionAttemptRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ExtensionValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extensions"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Object Hash",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Observed At",
      "type": "string"
    },
    "operational_receipt_family_id": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Operational Receipt Family Id",
      "type": "string"
    },
    "operational_receipt_id": {
      "format": "uuid",
      "title": "Operational Receipt Id",
      "type": "string"
    },
    "outcome_code": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Outcome Code",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "receipt_type": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Receipt Type",
      "type": "string"
    },
    "reconciliation": {
      "$ref": "#/$defs/Reconciliation"
    },
    "recorded_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Recorded At",
      "type": "string"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "subject_refs": {
      "items": {
        "$ref": "#/$defs/ExactObjectRef"
      },
      "minItems": 1,
      "title": "Subject Refs",
      "type": "array"
    },
    "supersedes_operational_receipt_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationalReceiptRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tenant": {
      "const": "bali-zero",
      "title": "Tenant",
      "type": "string"
    },
    "terminal_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionTerminalOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "operational_receipt_id",
    "operational_receipt_family_id",
    "contract_version",
    "tenant",
    "receipt_type",
    "subject_refs",
    "classification",
    "actor_or_executor",
    "outcome_code",
    "effects",
    "artifact_refs",
    "evidence_refs",
    "observed_at",
    "recorded_at",
    "idempotency_key",
    "reconciliation",
    "producer",
    "lineage",
    "retention",
    "object_hash"
  ],
  "title": "OperationalReceipt",
  "type": "object"
}
