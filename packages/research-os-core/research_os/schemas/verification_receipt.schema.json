{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "key_version": {
          "minLength": 1,
          "title": "Key Version",
          "type": "string"
        },
        "pseudonym": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pseudonym",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "approval",
            "verification",
            "queue_decision",
            "assignment",
            "execution",
            "audit"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "scheme": {
          "const": "hmac-sha256",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": ["scheme", "key_version", "purpose", "pseudonym"],
      "title": "ActorRef",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        }
      },
      "required": ["risk_class", "sensitivity"],
      "title": "Classification",
      "type": "object"
    },
    "ExactObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_kind": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Object Kind",
          "type": "string"
        }
      },
      "required": ["object_kind", "object_id", "object_hash"],
      "title": "ExactObjectRef",
      "type": "object"
    },
    "ExtensionValue": {
      "additionalProperties": false,
      "properties": {
        "extension_version": {
          "title": "Extension Version",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": ["extension_version", "payload"],
      "title": "ExtensionValue",
      "type": "object"
    },
    "GateDisposition": {
      "enum": ["pass", "fail", "insufficient_evidence", "not_applicable"],
      "title": "GateDisposition",
      "type": "string"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowRunRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["input_hashes"],
      "title": "Lineage",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "title": "Producer",
      "type": "object"
    },
    "Retention": {
      "additionalProperties": false,
      "properties": {
        "legal_hold": {
          "title": "Legal Hold",
          "type": "boolean"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        },
        "retention_class": {
          "enum": ["public_record", "operational", "audit", "restricted"],
          "title": "Retention Class",
          "type": "string"
        },
        "rights_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Expires At"
        }
      },
      "required": ["retention_class", "legal_hold"],
      "title": "Retention",
      "type": "object"
    },
    "RiskClass": {
      "enum": ["green", "amber", "red"],
      "title": "RiskClass",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted_osint",
        "client_pii"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SourceVersionRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "version_id": {
          "minLength": 1,
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": ["source_id", "version_id", "content_hash"],
      "title": "SourceVersionRef",
      "type": "object"
    },
    "TemporalScope": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Checked At",
          "type": "string"
        },
        "source_cutoff_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Cutoff At"
        },
        "target_valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Valid From"
        },
        "target_valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Valid To"
        }
      },
      "required": ["checked_at"],
      "title": "TemporalScope",
      "type": "object"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ExactObjectRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "note_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Code"
        },
        "result": {
          "$ref": "#/$defs/GateDisposition"
        }
      },
      "required": ["check_id", "result", "evidence_refs"],
      "title": "VerificationCheck",
      "type": "object"
    },
    "VerificationReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "verification_receipt_id": {
          "format": "uuid",
          "title": "Verification Receipt Id",
          "type": "string"
        }
      },
      "required": ["verification_receipt_id", "object_hash"],
      "title": "VerificationReceiptRef",
      "type": "object"
    },
    "VerificationVerdict": {
      "enum": ["pass", "pass_with_limits", "fail", "insufficient_evidence"],
      "title": "VerificationVerdict",
      "type": "string"
    },
    "VerifierRef": {
      "additionalProperties": false,
      "properties": {
        "actor_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "independence_class": {
          "minLength": 1,
          "title": "Independence Class",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version", "independence_class"],
      "title": "VerifierRef",
      "type": "object"
    },
    "WorkflowRunRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "workflow_run_id": {
          "format": "uuid",
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": ["workflow_run_id", "object_hash"],
      "title": "WorkflowRunRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "contract_version": {
      "const": "research-os/v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "criteria_version": {
      "minLength": 1,
      "title": "Criteria Version",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ExtensionValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extensions"
    },
    "issued_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Issued At",
      "type": "string"
    },
    "limits": {
      "items": {
        "type": "string"
      },
      "title": "Limits",
      "type": "array"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Object Hash",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "recorded_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Recorded At",
      "type": "string"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "source_versions": {
      "items": {
        "$ref": "#/$defs/SourceVersionRef"
      },
      "title": "Source Versions",
      "type": "array"
    },
    "supersedes_verification_receipt_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationReceiptRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target_objects": {
      "items": {
        "$ref": "#/$defs/ExactObjectRef"
      },
      "title": "Target Objects",
      "type": "array"
    },
    "temporal_scope": {
      "$ref": "#/$defs/TemporalScope"
    },
    "tenant": {
      "const": "bali-zero",
      "title": "Tenant",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/VerificationVerdict"
    },
    "verification_receipt_family_id": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Verification Receipt Family Id",
      "type": "string"
    },
    "verification_receipt_id": {
      "format": "uuid",
      "title": "Verification Receipt Id",
      "type": "string"
    },
    "verification_type": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Verification Type",
      "type": "string"
    },
    "verifier": {
      "$ref": "#/$defs/VerifierRef"
    }
  },
  "required": [
    "verification_receipt_id",
    "verification_receipt_family_id",
    "contract_version",
    "tenant",
    "target_objects",
    "verification_type",
    "verifier",
    "criteria_version",
    "temporal_scope",
    "checks",
    "verdict",
    "limits",
    "source_versions",
    "classification",
    "issued_at",
    "recorded_at",
    "producer",
    "lineage",
    "retention",
    "object_hash"
  ],
  "title": "VerificationReceipt",
  "type": "object"
}
