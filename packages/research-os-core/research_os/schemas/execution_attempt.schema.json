{
  "$defs": {
    "ActionIntentRef": {
      "additionalProperties": false,
      "description": "``{action_intent_id, object_hash}``, defined here (not in\n``action_intent.py``) so ``ActionItem.current_intent_ref`` and\n``ActionIntent.action_item_ref`` (section 13.2) can reference each\nother's exact identity without an import cycle between the two modules.",
      "properties": {
        "action_intent_id": {
          "format": "uuid",
          "title": "Action Intent Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        }
      },
      "required": ["action_intent_id", "object_hash"],
      "title": "ActionIntentRef",
      "type": "object"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "key_version": {
          "minLength": 1,
          "title": "Key Version",
          "type": "string"
        },
        "pseudonym": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pseudonym",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "approval",
            "verification",
            "queue_decision",
            "assignment",
            "execution",
            "audit"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "scheme": {
          "const": "hmac-sha256",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": ["scheme", "key_version", "purpose", "pseudonym"],
      "title": "ActorRef",
      "type": "object"
    },
    "ApprovalReceiptRef": {
      "additionalProperties": false,
      "description": "``{approval_receipt_id, object_hash}``, co-located here (not in\n``approval_receipt.py``) because ``ExecutionAttempt`` is its only\nconsumer in this kind group -- mirrors why ``ActionIntentRef`` lives in\n``action_item.py`` rather than ``action_intent.py``.",
      "properties": {
        "approval_receipt_id": {
          "format": "uuid",
          "title": "Approval Receipt Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        }
      },
      "required": ["approval_receipt_id", "object_hash"],
      "title": "ApprovalReceiptRef",
      "type": "object"
    },
    "ExecutionAttemptState": {
      "enum": ["started"],
      "title": "ExecutionAttemptState",
      "type": "string"
    },
    "Executor": {
      "additionalProperties": false,
      "properties": {
        "actor_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "title": "Executor",
      "type": "object"
    },
    "ExtensionValue": {
      "additionalProperties": false,
      "properties": {
        "extension_version": {
          "title": "Extension Version",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": ["extension_version", "payload"],
      "title": "ExtensionValue",
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowRunRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["input_hashes"],
      "title": "Lineage",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "title": "Producer",
      "type": "object"
    },
    "Retention": {
      "additionalProperties": false,
      "properties": {
        "legal_hold": {
          "title": "Legal Hold",
          "type": "boolean"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        },
        "retention_class": {
          "enum": ["public_record", "operational", "audit", "restricted"],
          "title": "Retention Class",
          "type": "string"
        },
        "rights_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Expires At"
        }
      },
      "required": ["retention_class", "legal_hold"],
      "title": "Retention",
      "type": "object"
    },
    "WorkflowRunRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "workflow_run_id": {
          "format": "uuid",
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": ["workflow_run_id", "object_hash"],
      "title": "WorkflowRunRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_intent_ref": {
      "$ref": "#/$defs/ActionIntentRef"
    },
    "approval_receipt_ref": {
      "$ref": "#/$defs/ApprovalReceiptRef"
    },
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "contract_version": {
      "const": "research-os/v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "execution_attempt_id": {
      "format": "uuid",
      "title": "Execution Attempt Id",
      "type": "string"
    },
    "executor": {
      "$ref": "#/$defs/Executor"
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ExtensionValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extensions"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Object Hash",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "started_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Started At",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ExecutionAttemptState"
    },
    "tenant": {
      "const": "bali-zero",
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "execution_attempt_id",
    "contract_version",
    "tenant",
    "action_intent_ref",
    "approval_receipt_ref",
    "attempt_number",
    "state",
    "idempotency_key",
    "executor",
    "started_at",
    "producer",
    "lineage",
    "retention",
    "object_hash"
  ],
  "title": "ExecutionAttempt",
  "type": "object"
}
