{
  "$defs": {
    "ActionIntentRef": {
      "additionalProperties": false,
      "description": "``{action_intent_id, object_hash}``, defined here (not in\n``action_intent.py``) so ``ActionItem.current_intent_ref`` and\n``ActionIntent.action_item_ref`` (section 13.2) can reference each\nother's exact identity without an import cycle between the two modules.",
      "properties": {
        "action_intent_id": {
          "format": "uuid",
          "title": "Action Intent Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        }
      },
      "required": ["action_intent_id", "object_hash"],
      "title": "ActionIntentRef",
      "type": "object"
    },
    "ActionItemRef": {
      "additionalProperties": false,
      "description": "``{action_item_id, object_hash}`` -- the typed pointer used everywhere\nthe chain names one exact ``ActionItem`` revision (never a bare family\nID, per primitive ``exact_object_ref``'s rule generalized to this kind).",
      "properties": {
        "action_item_id": {
          "format": "uuid",
          "title": "Action Item Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        }
      },
      "required": ["action_item_id", "object_hash"],
      "title": "ActionItemRef",
      "type": "object"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "key_version": {
          "minLength": 1,
          "title": "Key Version",
          "type": "string"
        },
        "pseudonym": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pseudonym",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "approval",
            "verification",
            "queue_decision",
            "assignment",
            "execution",
            "audit"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "scheme": {
          "const": "hmac-sha256",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": ["scheme", "key_version", "purpose", "pseudonym"],
      "title": "ActorRef",
      "type": "object"
    },
    "DecisionPacketRef": {
      "additionalProperties": false,
      "properties": {
        "decision_packet_id": {
          "format": "uuid",
          "title": "Decision Packet Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        }
      },
      "required": ["decision_packet_id", "object_hash"],
      "title": "DecisionPacketRef",
      "type": "object"
    },
    "ExtensionValue": {
      "additionalProperties": false,
      "properties": {
        "extension_version": {
          "title": "Extension Version",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": ["extension_version", "payload"],
      "title": "ExtensionValue",
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowRunRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["input_hashes"],
      "title": "Lineage",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "title": "Producer",
      "type": "object"
    },
    "QueueState": {
      "enum": [
        "new",
        "triaged",
        "assigned",
        "awaiting_decision",
        "ready",
        "closed"
      ],
      "title": "QueueState",
      "type": "string"
    },
    "RequestedActionSpecRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "requested_action_spec_id": {
          "format": "uuid",
          "title": "Requested Action Spec Id",
          "type": "string"
        }
      },
      "required": ["requested_action_spec_id", "object_hash"],
      "title": "RequestedActionSpecRef",
      "type": "object"
    },
    "Retention": {
      "additionalProperties": false,
      "properties": {
        "legal_hold": {
          "title": "Legal Hold",
          "type": "boolean"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        },
        "retention_class": {
          "enum": ["public_record", "operational", "audit", "restricted"],
          "title": "Retention Class",
          "type": "string"
        },
        "rights_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Expires At"
        }
      },
      "required": ["retention_class", "legal_hold"],
      "title": "Retention",
      "type": "object"
    },
    "RiskClass": {
      "enum": ["green", "amber", "red"],
      "title": "RiskClass",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted_osint",
        "client_pii"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "Sla": {
      "additionalProperties": false,
      "description": "``sla: {opened_at, due_at, paused_at?, breached_at?}``.\n\nINTERPRETATION: section 13.1 does not spell out an ordering invariant\nfor this sub-object the way primitive ``valid_time`` does for its\nhalf-open interval, but an SLA whose due date precedes its own open\ndate, or whose pause/breach instant precedes it opened, describes a\nclock that ran backwards. Mirrored on ``primitives.ValidTime``'s\nstrictly-later pattern rather than inventing a new idiom.",
      "properties": {
        "breached_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breached At"
        },
        "due_at": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Due At",
          "type": "string"
        },
        "opened_at": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Opened At",
          "type": "string"
        },
        "paused_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paused At"
        }
      },
      "required": ["opened_at", "due_at"],
      "title": "Sla",
      "type": "object"
    },
    "WorkflowRunRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "workflow_run_id": {
          "format": "uuid",
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": ["workflow_run_id", "object_hash"],
      "title": "WorkflowRunRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_item_family_id": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Action Item Family Id",
      "type": "string"
    },
    "action_item_id": {
      "format": "uuid",
      "title": "Action Item Id",
      "type": "string"
    },
    "close_reason": {
      "anyOf": [
        {
          "enum": ["completed", "rejected", "duplicate", "obsolete", "invalid"],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Close Reason"
    },
    "contract_version": {
      "const": "research-os/v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Created At",
      "type": "string"
    },
    "current_intent_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionIntentRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision_packet_ref": {
      "$ref": "#/$defs/DecisionPacketRef"
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ExtensionValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extensions"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Object Hash",
      "type": "string"
    },
    "owner_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "priority": {
      "enum": ["p0", "p1", "p2", "p3"],
      "title": "Priority",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "queue_state": {
      "$ref": "#/$defs/QueueState"
    },
    "recorded_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Recorded At",
      "type": "string"
    },
    "requested_action_spec_ref": {
      "$ref": "#/$defs/RequestedActionSpecRef"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "sla": {
      "$ref": "#/$defs/Sla"
    },
    "supersedes_action_item_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionItemRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tenant": {
      "const": "bali-zero",
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "action_item_id",
    "action_item_family_id",
    "revision",
    "contract_version",
    "tenant",
    "decision_packet_ref",
    "requested_action_spec_ref",
    "queue_state",
    "risk_class",
    "sensitivity",
    "priority",
    "sla",
    "created_at",
    "recorded_at",
    "producer",
    "lineage",
    "retention",
    "object_hash"
  ],
  "title": "ActionItem",
  "type": "object"
}
