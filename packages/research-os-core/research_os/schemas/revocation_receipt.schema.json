{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "key_version": {
          "minLength": 1,
          "title": "Key Version",
          "type": "string"
        },
        "pseudonym": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pseudonym",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "approval",
            "verification",
            "queue_decision",
            "assignment",
            "execution",
            "audit"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "scheme": {
          "const": "hmac-sha256",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": ["scheme", "key_version", "purpose", "pseudonym"],
      "title": "ActorRef",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        }
      },
      "required": ["risk_class", "sensitivity"],
      "title": "Classification",
      "type": "object"
    },
    "ExactObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_kind": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Object Kind",
          "type": "string"
        }
      },
      "required": ["object_kind", "object_id", "object_hash"],
      "title": "ExactObjectRef",
      "type": "object"
    },
    "ExtensionValue": {
      "additionalProperties": false,
      "properties": {
        "extension_version": {
          "title": "Extension Version",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": ["extension_version", "payload"],
      "title": "ExtensionValue",
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowRunRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["input_hashes"],
      "title": "Lineage",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "title": "Producer",
      "type": "object"
    },
    "PropagationTarget": {
      "additionalProperties": false,
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/ExactObjectRef"
        },
        "system": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "System",
          "type": "string"
        }
      },
      "required": ["system", "object_ref"],
      "title": "PropagationTarget",
      "type": "object"
    },
    "Retention": {
      "additionalProperties": false,
      "properties": {
        "legal_hold": {
          "title": "Legal Hold",
          "type": "boolean"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        },
        "retention_class": {
          "enum": ["public_record", "operational", "audit", "restricted"],
          "title": "Retention Class",
          "type": "string"
        },
        "rights_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Expires At"
        }
      },
      "required": ["retention_class", "legal_hold"],
      "title": "Retention",
      "type": "object"
    },
    "RevocationAuthority": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$",
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": ["role", "scope", "verified_at"],
      "title": "RevocationAuthority",
      "type": "object"
    },
    "RiskClass": {
      "enum": ["green", "amber", "red"],
      "title": "RiskClass",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted_osint",
        "client_pii"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "WorkflowRunRef": {
      "additionalProperties": false,
      "properties": {
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "workflow_run_id": {
          "format": "uuid",
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": ["workflow_run_id", "object_hash"],
      "title": "WorkflowRunRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_ref": {
      "$ref": "#/$defs/ActorRef"
    },
    "authority": {
      "$ref": "#/$defs/RevocationAuthority"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "contract_version": {
      "const": "research-os/v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ExtensionValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extensions"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Issued At",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Object Hash",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "reason_code": {
      "pattern": "^[a-z][a-z0-9]*[._-][a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9])*$",
      "title": "Reason Code",
      "type": "string"
    },
    "required_propagation_targets": {
      "items": {
        "$ref": "#/$defs/PropagationTarget"
      },
      "title": "Required Propagation Targets",
      "type": "array"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "revocation_receipt_id": {
      "format": "uuid",
      "title": "Revocation Receipt Id",
      "type": "string"
    },
    "target_ref": {
      "$ref": "#/$defs/ExactObjectRef"
    },
    "tenant": {
      "const": "bali-zero",
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "revocation_receipt_id",
    "contract_version",
    "tenant",
    "target_ref",
    "reason_code",
    "authority",
    "actor_ref",
    "required_propagation_targets",
    "classification",
    "issued_at",
    "idempotency_key",
    "producer",
    "lineage",
    "retention",
    "object_hash"
  ],
  "title": "RevocationReceipt",
  "type": "object"
}
