{
  "name": "mouth",
  "version": "5.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint .",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --coverage",
    "test:coverage:check": "node -e \"const fs=require('fs');const r=JSON.parse(fs.readFileSync('./coverage/coverage-summary.json','utf8'));const s=r.total.statements.pct;if(s<10){console.error('Coverage '+s+'% below 10% threshold');process.exit(1)}else{console.log('Coverage '+s+'% OK')}\"",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky",
    "generate:api": "openapi-typescript ../backend-rag/openapi.json -o src/lib/api/schema.d.ts",
    "gen:api-types": "npx openapi-typescript ../../apps/backend-rag/openapi.json -o src/lib/api/schema.d.ts",
    "validate:openapi": "node ../../scripts/validate-openapi.cjs",
    "lighthouse": "node scripts/lighthouse-ci.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.118",
    "@formkit/auto-animate": "^0.9.0",
    "@next/third-parties": "^16.1.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.43.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-virtual": "^3.13.13",
    "@types/dompurify": "^3.0.5",
    "ai": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.0",
    "framer-motion": "^12.36.0",
    "googleapis": "^171.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.556.0",
    "next": "^16.2.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.4.0",
    "uuid": "^14.0.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.1.4",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lighthouse": "^13.1.0",
    "lint-staged": "^17.0.4",
    "openapi-typescript": "^7.10.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
