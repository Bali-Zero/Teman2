# Copy to `.env.local` for local development.
#
# Backend API base URL (public, exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional (Playwright / E2E)
E2E_TEST_EMAIL=
E2E_TEST_PIN=
E2E_BASE_URL=
PLAYWRIGHT_BASE_URL=
WEBSOCKET_URL=
NUZANTARA_API_URL=http://localhost:8080

# Google Analytics GA4
# Create at: https://analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification
# Get from: https://search.google.com/search-console → Settings → Ownership verification
GOOGLE_SITE_VERIFICATION=

# Google Calendar API (Service Account)
# Create a service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Google Calendar API: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# Share your calendar with the service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
