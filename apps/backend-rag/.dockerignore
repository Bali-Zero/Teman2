# NOTE (2026-04-16, PR #62): Fly builds `nuzantara-rag` with build context at
# monorepo root (see .github/workflows/fly-deploy.yml `--dockerfile` flag).
# The authoritative dockerignore for the deployed image is /.dockerignore at
# repo root. This file is retained for local `docker build` runs that use
# `apps/backend-rag/` as the explicit build context, but is IGNORED by Fly.

# Exclude everything first
*

# Include what we need
!backend/
!training-data/
!scripts/
!requirements-prod.txt
!requirements.txt
!Dockerfile

# Exclude from included directories
backend/.env*
backend/tests/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.DS_Store
**/*.log

# Secrets (never include in images)
**/google_credentials.json
**/*credentials*.json
**/*.pem
**/*.key

# Large files
**/*.pdf
**/*.docx
**/*.xlsx
**/*.zip
**/*.tar.gz
**/*.jpg
**/*.png
**/*.gif
**/*.mp4
**/*.mov
