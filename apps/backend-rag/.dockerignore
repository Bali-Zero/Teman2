# Exclude everything first
*

# Include what we need
!backend/
!training-data/
!scripts/
!requirements-prod.txt
!requirements.txt
!Dockerfile
!fly.toml

# Exclude from included directories
backend/.env*
backend/tests/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.DS_Store
**/*.log

# Secrets (never include in images)
**/google_credentials.json
**/*credentials*.json
**/*.pem
**/*.key

# Large files
**/*.pdf
**/*.docx
**/*.xlsx
**/*.zip
**/*.tar.gz
**/*.jpg
**/*.png
**/*.gif
**/*.mp4
**/*.mov
