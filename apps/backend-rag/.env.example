# ========================================
# NUZANTARA BACKEND - Environment Variables Template
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets!

# ========================================
# PROJECT CONFIGURATION
# ========================================
ENVIRONMENT=development

# ========================================
# AI PROVIDERS - CRITICAL FOR CHAT FUNCTIONALITY
# ========================================
# OpenAI API Key (Required for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Google API Key (Required for KBLI Notebook chat and other AI features)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# OR use Google Service Account (alternative to GOOGLE_API_KEY, preferred for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# GEMINI_SA_TOKEN=your-gemini-sa-token-here

# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://user:password@host:port/database

# ========================================
# VECTOR DATABASE (Qdrant)
# ========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# ========================================
# CACHE (Redis)
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# AUTHENTICATION
# ========================================
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-long
API_KEYS=your-api-key-1,your-api-key-2

# ========================================
# WEBHOOKS
# ========================================
OPENCLAW_WEBHOOK_SECRET=your-openclaw-webhook-secret-here

# ========================================
# OPTIONAL: FALLBACK AI PROVIDERS
# ========================================
# OpenRouter API Key (Used as fallback if Gemini fails)
# OPENROUTER_API_KEY=your-openrouter-key-here
