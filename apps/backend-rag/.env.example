# ========================================
# NUZANTARA BACKEND - Environment Variables Template
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets!

# ========================================
# PROJECT CONFIGURATION
# ========================================
ENVIRONMENT=development

# ========================================
# AI PROVIDERS - CRITICAL FOR CHAT FUNCTIONALITY
# ========================================
# OpenAI API Key (Required for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Google API Key (Required for KBLI Notebook chat and other AI features)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# OR use Google Service Account (alternative to GOOGLE_API_KEY, preferred for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# GEMINI_SA_TOKEN=your-gemini-sa-token-here

# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://user:password@host:port/database

# ========================================
# VECTOR DATABASE (Qdrant)
# ========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# ========================================
# CACHE (Redis)
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# AUTHENTICATION
# ========================================
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-long
API_KEYS=your-api-key-1,your-api-key-2

# ========================================
# WEBHOOKS
# ========================================
OPENCLAW_WEBHOOK_SECRET=your-openclaw-webhook-secret-here

# ========================================
# OPTIONAL: FALLBACK AI PROVIDERS
# ========================================
# OpenRouter API Key (Used as fallback if Gemini fails)
# OPENROUTER_API_KEY=your-openrouter-key-here

# ========================================
# OPTIONAL: VOICE CONCIERGE LOCAL AUDIO (PRO/MINI ONLY)
# ========================================
# Keep these off in deployable cloud environments. The local audio overlay is
# for Pro/Mini runtime verification and concierge prototyping only.
# VOICE_CONCIERGE_LOCAL_AUDIO_ENABLED=false
# VOICE_CONCIERGE_LOCAL_AUDIO=false
# VOICE_CONCIERGE_WHISPER_BINARY=/opt/homebrew/bin/whisper-cli
# VOICE_CONCIERGE_WHISPER_MODEL=/Users/nuzantara/models/whisper/ggml-large-v3-turbo.bin
# VOICE_CONCIERGE_WHISPER_TIMEOUT_SECONDS=30
# VOICE_CONCIERGE_AUDIO_MAX_BYTES=10485760
# VOICE_CONCIERGE_TTS_MAX_CHARS=1200
# VOICE_CONCIERGE_TTS_AUDIO_MAX_BYTES=10485760
# VOICE_CONCIERGE_SILERO_MODULE=silero_vad
# VOICE_CONCIERGE_SILERO_SAMPLING_RATE=16000
# VOICE_CONCIERGE_SILERO_THRESHOLD=0.5
# VOICE_CONCIERGE_SILERO_TIMEOUT_SECONDS=15
# Doctor gate: explicit JSON health payload from the local worker/sidecar.
# VOICE_CONCIERGE_LIVEKIT_WORKER_HEALTH_URL=http://127.0.0.1:7889/healthz
# VOICE_CONCIERGE_LIVEKIT_WORKER_HEALTH_TIMEOUT_SECONDS=2
# Native LiveKit Agents health is GET / with text OK and is used by the sidecar.
# VOICE_CONCIERGE_LIVEKIT_WORKER_NATIVE_HEALTH_URL=http://127.0.0.1:7888/
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=<local-livekit-api-key>
# LIVEKIT_API_SECRET=<local-livekit-api-secret>
# VOICE_CONCIERGE_LIVEKIT_AGENT_NAME=voice-concierge-local
# VOICE_CONCIERGE_CHATTERBOX_MODULE=chatterbox
# VOICE_CONCIERGE_CHATTERBOX_MODEL_PATH=/Users/nuzantara/.cache/huggingface/hub/models--ResembleAI--chatterbox/snapshots/<snapshot-id>
# VOICE_CONCIERGE_CHATTERBOX_T3_MODEL=v3
# VOICE_CONCIERGE_CHATTERBOX_LANGUAGE=en
# VOICE_CONCIERGE_CHATTERBOX_TIMEOUT_SECONDS=60
# VOICE_CONCIERGE_PKUSEG_CACHE_DIR=/Users/nuzantara/.pkuseg
# DO_NOT_TRACK=1
# HF_DATASETS_OFFLINE=1
# HF_HUB_DISABLE_TELEMETRY=1
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ========================================
# OBSERVABILITY: LANGFUSE (POC)
# ========================================
# Enabled by default when both keys are set. Unset or "false" disables.
# See apps/backend-rag/README.md "Langfuse POC" for kill-switch procedure.
# LANGFUSE_ENABLED=true                                   # default: true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_HOST=https://us.cloud.langfuse.com             # default: US region
# LANGFUSE_ENVIRONMENT=local                              # default: FLY_APP_NAME or "local"
# LANGFUSE_RELEASE=                                       # default: FLY_MACHINE_VERSION
# LANGFUSE_FLUSH_AT=15                                    # batch before flush
# LANGFUSE_FLUSH_INTERVAL=1.0                             # max seconds between flushes
# LANGFUSE_TRACE_LLM_MESSAGES=false                       # true = capture raw Anthropic
                                                          # prompts/responses. Default OFF
                                                          # for UU PDP compliance.
