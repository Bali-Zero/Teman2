{
  "dashboard": {
    "title": "NUZANTARA Portal - Tax & Visa Monitoring",
    "tags": ["nuzantara", "portal", "tax", "visa"],
    "timezone": "Asia/Singapore",
    "schemaVersion": 38,
    "refresh": "30s",
    "panels": [
      {
        "title": "Tax Endpoint - Request Rate",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(portal_tax_requests_total{status=\"success\"}[5m])",
            "legendFormat": "Success",
            "refId": "A"
          },
          {
            "expr": "rate(portal_tax_requests_total{status=\"error\"}[5m])",
            "legendFormat": "Error",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Visa Endpoint - Request Rate",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(portal_visa_requests_total{status=\"success\"}[5m])",
            "legendFormat": "Success",
            "refId": "A"
          },
          {
            "expr": "rate(portal_visa_requests_total{status=\"error\"}[5m])",
            "legendFormat": "Error",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Tax Endpoint - Success Rate",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(portal_tax_requests_total{status=\"success\"}[5m])) / sum(rate(portal_tax_requests_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 95,
                  "color": "yellow"
                },
                {
                  "value": 99,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Visa Endpoint - Success Rate",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(portal_visa_requests_total{status=\"success\"}[5m])) / sum(rate(portal_visa_requests_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 95,
                  "color": "yellow"
                },
                {
                  "value": 99,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Deadline Checker - Execution Count",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "deadline_checker_total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "blue"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Deadline Checker - Last Run",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "time() - deadline_checker_last_run_timestamp",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 86400,
                  "color": "yellow"
                },
                {
                  "value": 172800,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Tax Endpoint - Latency (p50, p95, p99)",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(portal_tax_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(portal_tax_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(portal_tax_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Visa Endpoint - Latency (p50, p95, p99)",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(portal_visa_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(portal_visa_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(portal_visa_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Deadline Reminders Created - By Type & Urgency",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(deadline_reminders_created{type=\"tax\",urgency=\"critical\"}[1h])",
            "legendFormat": "Tax - Critical",
            "refId": "A"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"tax\",urgency=\"warning\"}[1h])",
            "legendFormat": "Tax - Warning",
            "refId": "B"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"tax\",urgency=\"info\"}[1h])",
            "legendFormat": "Tax - Info",
            "refId": "C"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"visa\",urgency=\"critical\"}[1h])",
            "legendFormat": "Visa - Critical",
            "refId": "D"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"visa\",urgency=\"warning\"}[1h])",
            "legendFormat": "Visa - Warning",
            "refId": "E"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"visa\",urgency=\"info\"}[1h])",
            "legendFormat": "Visa - Info",
            "refId": "F"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Reminders/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Tax Requests - By Endpoint",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "sum by (endpoint) (portal_tax_requests_total)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {},
              "renameByName": {
                "endpoint": "Endpoint",
                "Value": "Total Requests"
              }
            }
          }
        ]
      },
      {
        "title": "Visa Requests - By Endpoint",
        "type": "table",
        "gridPos": {
          "x": 12,
          "y": 28,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "sum by (endpoint) (portal_visa_requests_total)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {},
              "renameByName": {
                "endpoint": "Endpoint",
                "Value": "Total Requests"
              }
            }
          }
        ]
      },
      {
        "title": "RAG Stage Timing",
        "type": "row",
        "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 },
        "collapsed": false,
        "panels": []
      },
      {
        "title": "RAG Stage Latency (P50/P95/P99, ms)",
        "type": "timeseries",
        "datasource": { "type": "postgres", "uid": "nuzantara-postgres" },
        "gridPos": { "x": 0, "y": 21, "w": 24, "h": 9 },
        "targets": [
          {
            "refId": "A",
            "format": "time_series",
            "rawQuery": true,
            "rawSql": "WITH span AS (SELECT date_trunc('minute', t.created_at) AS ts, (s->>'stage') AS stage, (s->>'duration_ms')::numeric AS duration_ms FROM rag_traces t, jsonb_array_elements(t.root_span->'spans') s WHERE $__timeFilter(t.created_at)) SELECT ts AS time, stage || ' p50' AS metric, percentile_cont(0.50) WITHIN GROUP (ORDER BY duration_ms) AS value FROM span GROUP BY ts, stage UNION ALL SELECT ts AS time, stage || ' p95' AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) AS value FROM span GROUP BY ts, stage UNION ALL SELECT ts AS time, stage || ' p99' AS metric, percentile_cont(0.99) WITHIN GROUP (ORDER BY duration_ms) AS value FROM span GROUP BY ts, stage ORDER BY 1"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "ms" },
          "overrides": []
        }
      },
      {
        "title": "RAG Cost",
        "type": "row",
        "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
        "collapsed": false,
        "panels": []
      },
      {
        "title": "Cost per Query (USD, by domain — last 24h)",
        "type": "barchart",
        "datasource": { "type": "postgres", "uid": "nuzantara-postgres" },
        "gridPos": { "x": 0, "y": 31, "w": 12, "h": 9 },
        "targets": [
          {
            "refId": "A",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT COALESCE(domain, 'unknown') AS domain, AVG(total_cost_usd)::numeric(12,6) AS avg_cost_usd FROM rag_traces WHERE created_at > NOW() - INTERVAL '24 hours' GROUP BY domain ORDER BY avg_cost_usd DESC LIMIT 10"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "currencyUSD" },
          "overrides": []
        }
      },
      {
        "title": "Cache Hit Rate by Stage (last 24h)",
        "type": "gauge",
        "datasource": { "type": "postgres", "uid": "nuzantara-postgres" },
        "gridPos": { "x": 12, "y": 31, "w": 12, "h": 9 },
        "targets": [
          {
            "refId": "A",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT (s->>'stage') AS stage, AVG(CASE WHEN (s->>'cache_hit')::boolean THEN 1.0 ELSE 0.0 END)::numeric(5,4) AS hit_rate FROM rag_traces t, jsonb_array_elements(t.root_span->'spans') s WHERE t.created_at > NOW() - INTERVAL '24 hours' AND (s->>'cache_hit') IS NOT NULL GROUP BY stage ORDER BY stage"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
          "overrides": []
        }
      },
      {
        "title": "RAG Spend Leaderboard",
        "type": "row",
        "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
        "collapsed": false,
        "panels": []
      },
      {
        "title": "Top Domains by Cost (last 7 days)",
        "type": "table",
        "datasource": { "type": "postgres", "uid": "nuzantara-postgres" },
        "gridPos": { "x": 0, "y": 41, "w": 24, "h": 9 },
        "targets": [
          {
            "refId": "A",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT COALESCE(domain, 'unknown') AS domain, COUNT(*) AS queries, SUM(total_cost_usd)::numeric(12,6) AS total_cost_usd, AVG(total_cost_usd)::numeric(12,6) AS avg_cost_usd, AVG(total_duration_ms)::int AS avg_duration_ms FROM rag_traces WHERE created_at > NOW() - INTERVAL '7 days' GROUP BY domain ORDER BY total_cost_usd DESC"
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "total_cost_usd" },
              "properties": [{ "id": "unit", "value": "currencyUSD" }]
            },
            {
              "matcher": { "id": "byName", "options": "avg_cost_usd" },
              "properties": [{ "id": "unit", "value": "currencyUSD" }]
            },
            {
              "matcher": { "id": "byName", "options": "avg_duration_ms" },
              "properties": [{ "id": "unit", "value": "ms" }]
            }
          ]
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    },
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  }
}
