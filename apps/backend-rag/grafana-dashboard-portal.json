{
  "dashboard": {
    "title": "NUZANTARA Portal - Tax & Visa Monitoring",
    "tags": ["nuzantara", "portal", "tax", "visa"],
    "timezone": "Asia/Singapore",
    "schemaVersion": 38,
    "refresh": "30s",
    "panels": [
      {
        "title": "Tax Endpoint - Request Rate",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(portal_tax_requests_total{status=\"success\"}[5m])",
            "legendFormat": "Success",
            "refId": "A"
          },
          {
            "expr": "rate(portal_tax_requests_total{status=\"error\"}[5m])",
            "legendFormat": "Error",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Visa Endpoint - Request Rate",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(portal_visa_requests_total{status=\"success\"}[5m])",
            "legendFormat": "Success",
            "refId": "A"
          },
          {
            "expr": "rate(portal_visa_requests_total{status=\"error\"}[5m])",
            "legendFormat": "Error",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Tax Endpoint - Success Rate",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(portal_tax_requests_total{status=\"success\"}[5m])) / sum(rate(portal_tax_requests_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 95,
                  "color": "yellow"
                },
                {
                  "value": 99,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Visa Endpoint - Success Rate",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(portal_visa_requests_total{status=\"success\"}[5m])) / sum(rate(portal_visa_requests_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 95,
                  "color": "yellow"
                },
                {
                  "value": 99,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Deadline Checker - Execution Count",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "deadline_checker_total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "blue"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Deadline Checker - Last Run",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "time() - deadline_checker_last_run_timestamp",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 86400,
                  "color": "yellow"
                },
                {
                  "value": 172800,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "title": "Tax Endpoint - Latency (p50, p95, p99)",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(portal_tax_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(portal_tax_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(portal_tax_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Visa Endpoint - Latency (p50, p95, p99)",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(portal_visa_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(portal_visa_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(portal_visa_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Deadline Reminders Created - By Type & Urgency",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(deadline_reminders_created{type=\"tax\",urgency=\"critical\"}[1h])",
            "legendFormat": "Tax - Critical",
            "refId": "A"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"tax\",urgency=\"warning\"}[1h])",
            "legendFormat": "Tax - Warning",
            "refId": "B"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"tax\",urgency=\"info\"}[1h])",
            "legendFormat": "Tax - Info",
            "refId": "C"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"visa\",urgency=\"critical\"}[1h])",
            "legendFormat": "Visa - Critical",
            "refId": "D"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"visa\",urgency=\"warning\"}[1h])",
            "legendFormat": "Visa - Warning",
            "refId": "E"
          },
          {
            "expr": "rate(deadline_reminders_created{type=\"visa\",urgency=\"info\"}[1h])",
            "legendFormat": "Visa - Info",
            "refId": "F"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Reminders/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "title": "Tax Requests - By Endpoint",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "sum by (endpoint) (portal_tax_requests_total)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {},
              "renameByName": {
                "endpoint": "Endpoint",
                "Value": "Total Requests"
              }
            }
          }
        ]
      },
      {
        "title": "Visa Requests - By Endpoint",
        "type": "table",
        "gridPos": {
          "x": 12,
          "y": 28,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "sum by (endpoint) (portal_visa_requests_total)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {},
              "renameByName": {
                "endpoint": "Endpoint",
                "Value": "Total Requests"
              }
            }
          }
        ]
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    },
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  }
}
