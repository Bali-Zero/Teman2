    "NotInCondition": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/FactPath"
        },
        "op": {
          "const": "not_in",
          "title": "Op",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
