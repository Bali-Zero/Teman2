                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": ["fact", "values", "op"],
      "title": "InCondition",
      "type": "object"
    },
    "IntersectsCondition": {
      "additionalProperties": false,
      "description": "True iff the fact's set-value and ``values`` share at least one element.",
      "properties": {
        "fact": {
          "$ref": "#/$defs/FactPath"
        },
        "op": {
          "const": "intersects",
          "title": "Op",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
