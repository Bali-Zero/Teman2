    "NotCondition": {
      "additionalProperties": false,
      "description": "Negation: TRUE<->FALSE swap; UNKNOWN remains UNKNOWN (spec \u00a74.1).",
      "properties": {
        "arg": {
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllCondition",
              "any": "#/$defs/AnyCondition",
              "between": "#/$defs/BetweenCondition",
              "contains_all": "#/$defs/ContainsAllCondition",
