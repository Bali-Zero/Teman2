                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": ["fact", "values", "op"],
      "title": "IntersectsCondition",
      "type": "object"
