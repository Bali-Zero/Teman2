          "title": "Value"
        }
      },
      "required": ["fact", "value", "op"],
      "title": "GtCondition",
      "type": "object"
    },
    "GteCondition": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/FactPath"
        },
        "op": {
          "const": "gte",
          "title": "Op",
          "type": "string"
        },
        "value": {
