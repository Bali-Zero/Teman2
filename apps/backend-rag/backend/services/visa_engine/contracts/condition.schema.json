    "PresenceCondition": {
      "additionalProperties": false,
      "description": "``known``: TRUE iff the fact is KNOWN, else FALSE.\n``unknown``: TRUE iff the fact is UNKNOWN, else FALSE (spec \u00a74.1).",
      "properties": {
        "fact": {
          "$ref": "#/$defs/FactPath"
        },
        "op": {
          "enum": ["known", "unknown"],
          "title": "Op",
          "type": "string"
        }
      },
      "required": ["op", "fact"],
      "title": "PresenceCondition",
      "type": "object"
    }
  },
