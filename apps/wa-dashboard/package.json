{
  "name": "wa-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Bali Zero team WhatsApp inbox dashboard (M1 read-only)",
  "scripts": {
    "dev": "next dev --port 3030",
    "dev:proxy": "node scripts/dev-proxy-server.js",
    "build": "next build",
    "start": "next start --port 3030",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.469.0",
    "next": "^16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.12.3",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "tailwindcss": "^4",
    "typescript": "^5.7",
    "vitest": "^4.1.10"
  }
}
