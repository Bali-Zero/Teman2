# Primary: Pro local Postgres (preferred when DB is local)
DATABASE_URL_LOCAL=postgresql://nuzantara:PASS@localhost:5432/nuzantara

# Fallback: Fly tunnel. Start with `fly proxy 15432 -a nuzantara-postgres`
# then export this URL. The app auto-detects and uses whichever is set.
FLY_TUNNEL_URL=postgresql://backend_rag_v2:PASS@localhost:15432/nuzantara_rag

# Required for server startup (next.config.mjs hard-checks this).
LOCAL_ONLY=1
