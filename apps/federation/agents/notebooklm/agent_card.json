{
  "name": "NotebookLM (Google AI Ultra)",
  "description": "L'Oracolo — knowledge synthesis with citations",
  "url": "http://localhost:8087/",
  "version": "1.0.0",
  "protocol_version": "0.3.0",
  "provider": {
    "organization": "Nuzantara Federation",
    "url": "https://kita.balizero.com"
  },
  "capabilities": {
    "streaming": false,
    "push_notifications": false,
    "state_transition_history": true
  },
  "default_input_modes": ["text/plain"],
  "default_output_modes": ["text/plain"],
  "skills": [
    {
      "id": "notebook-research",
      "name": "Notebook Research",
      "description": "Deep web research with auto-import of sources into knowledge base",
      "tags": [
        "research",
        "ricerca",
        "deep research",
        "investigate",
        "indaga",
        "fonti",
        "sources"
      ],
      "examples": ["Help me with research", "I need information about ricerca"]
    },
    {
      "id": "notebook-synthesis",
      "name": "Notebook Synthesis",
      "description": "Multi-document synthesis with exact citations from curated knowledge",
      "tags": [
        "synthesis",
        "sintesi",
        "compare",
        "confronta",
        "multi-domain",
        "cross-domain",
        "citazione",
        "citation"
      ],
      "examples": ["Help me with synthesis", "I need information about sintesi"]
    },
    {
      "id": "notebook-media",
      "name": "Notebook Media",
      "description": "AI-generated audio podcasts, quizzes, flashcards, mind maps, study guides from knowledge",
      "tags": [
        "podcast",
        "audio",
        "quiz",
        "flashcard",
        "mind map",
        "study guide",
        "guida",
        "briefing"
      ],
      "examples": ["Help me with podcast", "I need information about audio"]
    },
    {
      "id": "notebook-management",
      "name": "Notebook Management",
      "description": "Create, populate, and manage knowledge notebooks",
      "tags": [
        "notebook",
        "create notebook",
        "add source",
        "populate",
        "knowledge base"
      ],
      "examples": [
        "Help me with notebook",
        "I need information about create notebook"
      ]
    }
  ],
  "extensions": [
    {
      "uri": "urn:nuzantara:dispatch",
      "description": "CLI dispatch command: nlm-query",
      "params": {
        "dispatch_cmd": "nlm-query",
        "cost": "$0 (Google AI Ultra subscription)",
        "limits": "3-15s latency, cookie auth fragile, 50 sources/notebook, no live DB access"
      }
    }
  ]
}
