{
  "name": "Gemini 3.1 Pro (Search)",
  "description": "Il Consigliere — grounded web search",
  "url": "http://localhost:8082/",
  "version": "1.0.0",
  "protocol_version": "0.3.0",
  "provider": {
    "organization": "Nuzantara Federation",
    "url": "https://kita.balizero.com"
  },
  "capabilities": {
    "streaming": true,
    "push_notifications": false,
    "state_transition_history": true
  },
  "default_input_modes": ["text/plain"],
  "default_output_modes": ["text/plain"],
  "skills": [
    {
      "id": "regulations",
      "name": "Regulations",
      "description": "Indonesian law, KBLI codes, visa rules, tax, permits",
      "tags": [
        "KBLI",
        "visa",
        "KITAS",
        "KITAP",
        "PMA",
        "tax",
        "pajak",
        "regulation",
        "normativa",
        "legge"
      ],
      "examples": ["Help me with KBLI", "I need information about visa"]
    }
  ],
  "extensions": [
    {
      "uri": "urn:nuzantara:dispatch",
      "description": "CLI dispatch command: search",
      "params": {
        "dispatch_cmd": "search",
        "cost": "$0 (Google AI Ultra)",
        "limits": "read-only, no code execution"
      }
    }
  ]
}
