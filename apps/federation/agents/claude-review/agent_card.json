{
  "name": "Claude CLI (Opus 4.6)",
  "description": "Il Giudice — code review, red team",
  "url": "http://localhost:8085/",
  "version": "1.0.0",
  "protocol_version": "0.3.0",
  "provider": {
    "organization": "Nuzantara Federation",
    "url": "https://kita.balizero.com"
  },
  "capabilities": {
    "streaming": true,
    "push_notifications": false,
    "state_transition_history": true
  },
  "default_input_modes": ["text/plain"],
  "default_output_modes": ["text/plain"],
  "skills": [
    {
      "id": "security",
      "name": "Security",
      "description": "Pre-deploy review, red team, vulnerability analysis",
      "tags": [
        "security",
        "review",
        "red team",
        "vulnerability",
        "deploy",
        "audit"
      ],
      "examples": ["Help me with security", "I need information about review"]
    }
  ],
  "extensions": [
    {
      "uri": "urn:nuzantara:dispatch",
      "description": "CLI dispatch command: claude-redteam",
      "params": {
        "dispatch_cmd": "claude-redteam",
        "cost": "$0 (Max plan)",
        "limits": "read-only (plan mode), no code execution"
      }
    }
  ]
}
