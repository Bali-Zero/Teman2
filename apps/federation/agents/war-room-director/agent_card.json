{
  "name": "War Room Director",
  "description": "Creative director — writes slide copy, image prompts, Instagram caption via Gemini",
  "url": "http://localhost:8103/",
  "version": "1.0.0",
  "protocol_version": "0.3.0",
  "provider": {
    "organization": "Nuzantara Federation",
    "url": "https://kita.balizero.com"
  },
  "capabilities": {
    "streaming": false,
    "push_notifications": false,
    "state_transition_history": true
  },
  "default_input_modes": ["text/plain"],
  "default_output_modes": ["application/json"],
  "skills": [
    {
      "id": "slide-direction",
      "name": "Slide Direction",
      "description": "Creative director — writes slide copy, image prompts, Instagram caption via Gemini",
      "tags": ["copywriting", "slides", "instagram", "director", "war-room"],
      "examples": [
        "Write slide copy for PMA carousel",
        "Generate Instagram caption and image prompts"
      ]
    }
  ],
  "extensions": [
    {
      "uri": "urn:nuzantara:dispatch",
      "description": "CLI dispatch command: war-room-director",
      "params": {
        "dispatch_cmd": "war-room-director",
        "cost": "$0 (Gemini CLI)"
      }
    }
  ]
}
