# Bali Zero Calendar - Environment Variables

# Google Calendar API (Service Account)
# The JSON key file from Google Cloud Console for the service account
# that has access to the Bali Zero Google Calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Default calendar ID (the Bali Zero team calendar)
# Can be overridden to use a different calendar as the default.
GOOGLE_CALENDAR_ID=ec0863e7c14ac6bf414ec23e2aab81960ecb26823c6a8f397c664fc64901d617@group.calendar.google.com
