<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for WA Meta Inbox local proxy (Section 5 of spec).
  This is a .example with __PLACEHOLDER__ tokens. install_app.sh materializes
  the real plist into ~/Library/LaunchAgents/, then `plutil -lint` + idempotent
  bootout/bootstrap. Do NOT bootstrap this .example directly.

  Label/port/logs are UNIQUE — no collision with com.balizero.wa-dashboard-m1
  (which owns :7790). This service owns :7791.

  Placeholders:
    __NODE_BIN__       absolute node path (e.g. /opt/homebrew/bin/node)
    __SERVER_CJS__     absolute path to this app's server.cjs
    __WORKING_DIR__    absolute path to apps/wa-meta-inbox
    __LOG_OUT__        absolute stdout log path
    __LOG_ERR__        absolute stderr log path
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.balizero.wa-meta-inbox</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BIN__</string>
		<string>__SERVER_CJS__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>WA_INBOX_PORT</key>
		<string>7791</string>
		<key>WA_INBOX_BACKEND_URL</key>
		<string>https://nuzantara-rag.fly.dev</string>
		<key>WA_INBOX_KEYCHAIN_SERVICE</key>
		<string>wa-inbox-api-key</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__WORKING_DIR__</string>
	<key>StandardOutPath</key>
	<string>__LOG_OUT__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_ERR__</string>
</dict>
</plist>
