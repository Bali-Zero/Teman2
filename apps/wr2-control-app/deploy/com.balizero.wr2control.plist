<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.balizero.wr2control</string>
  <!-- App lives under ~/Applications, NOT ~/Desktop (scar W84: launchd loses the TCC
       grant for ~/Desktop and the worker dies "green"). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nuzantara/Desktop/nuzantara/apps/wr2-control-app/deploy/run-wr2control.sh</string>
    <string>/Users/nuzantara/Applications/WR2 Control.app/Contents/MacOS/WR2Control</string>
    <string>--ambient</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- KeepAlive only-on-crash: this is a long-lived GUI app, NOT a one-shot, so relaunch
       on abnormal exit is correct (this is NOT scar #7, which is KeepAlive on a one-shot). -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <!-- The Mini has no local war-room data; point the app at the synced copy from the Pro. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>WR2_WARROOM_ROOT</key><string>/Users/nuzantara/.wr2-warroom-sync/output</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/nuzantara/Library/Logs/wr2control.log</string>
  <key>StandardErrorPath</key><string>/Users/nuzantara/Library/Logs/wr2control.err</string>
</dict>
</plist>
