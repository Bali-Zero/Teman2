# wa-mirror — environment template
# Copy to ~/.wa-mirror.env (or APP-LOCAL .env) and fill in.

# REQUIRED — Postgres connection. Reuses the Fly nuzantara-postgres proxy on
# Pro/Mini-Pro2 (port 15432 → flycast).
WA_MIRROR_DATABASE_URL=postgresql://backend_rag_v2:CHANGE_ME@localhost:15432/nuzantara_rag

# Comma-separated list of team-member WhatsApp accounts to connect on daemon
# start. Each phone maps to one Baileys session under apps/wa-mirror/sessions/<phone>/.
WA_MIRROR_ACCOUNTS=+628213107363,+6281234567890

# Optional JSON map for Telegram/log labels.
WA_MIRROR_ACCOUNT_NAMES={"+628213107363":"Zero","+6281234567890":"Adit"}

# Label shown to the team member in WhatsApp → Settings → Linked Devices.
WA_MIRROR_SESSION_LABEL=Bali Zero WA-Mirror

# Root dir for Baileys auth state files. Default: apps/wa-mirror/sessions
# WA_MIRROR_SESSIONS_ROOT=/Users/nuzantara/Desktop/nuzantara/apps/wa-mirror/sessions

# Local media storage. Default: ~/wa-mirror-media
# WA_MIRROR_MEDIA_ROOT=/Users/nuzantara/wa-mirror-media

# Optional OCR/backend controls. If the repo has no /api/ocr/extract router,
# OCR is skipped automatically unless WA_MIRROR_FORCE_OCR=1.
# WA_MIRROR_BACKEND_URL=http://127.0.0.1:8000
# WA_MIRROR_OCR_ENDPOINT=http://127.0.0.1:8000/api/ocr/extract
# WA_MIRROR_DISABLE_OCR=1

# Telegram alerts.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_OWNER_CHAT_ID=CHANGE_ME

# PG pool max connections (default 5).
# WA_MIRROR_PG_MAX_CONN=5

# Log level: trace|debug|info|warn|error
WA_MIRROR_LOG_LEVEL=info
