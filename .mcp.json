{
  "mcpServers": {
    "nuzantara-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost:5432/nuzantara"
      ],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    },
    "nuzantara-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/nuzantara/Desktop/nuzantara"
      ]
    },
    "nuzantara-fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    }
  }
}
