{
  "mcpServers": {
    "nuzantara-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost:5432/nuzantara"
      ],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    },
    "nuzantara-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/nuzantara/Desktop/nuzantara"
      ]
    },
    "nuzantara-fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "nuzantara-mcp": {
      "command": "/Users/nuzantara/Desktop/nuzantara/apps/nuzantara-mcp/.venv/bin/python",
      "args": ["apps/nuzantara-mcp/nuzantara_mcp/server.py"],
      "cwd": "/Users/nuzantara/Desktop/nuzantara",
      "env": {
        "PYTHONPATH": "apps/nuzantara-mcp"
      }
    },
    "nuzantara-mcp-advanced": {
      "command": "/Users/nuzantara/Desktop/nuzantara/apps/nuzantara-mcp-advanced/.venv/bin/python",
      "args": ["apps/nuzantara-mcp-advanced/nuzantara_mcp_advanced/server.py"],
      "cwd": "/Users/nuzantara/Desktop/nuzantara",
      "env": {
        "PYTHONPATH": "apps/nuzantara-mcp-advanced"
      }
    },
    "playwright": {
      "command": "/Users/nuzantara/Desktop/nuzantara/apps/nuzantara-mcp-browser/.venv/bin/python",
      "args": ["apps/nuzantara-mcp-browser/nuzantara_mcp_browser/server.py"],
      "cwd": "/Users/nuzantara/Desktop/nuzantara",
      "env": {
        "PYTHONPATH": "apps/nuzantara-mcp-browser"
      }
    }
  }
}
