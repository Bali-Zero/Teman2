# Agent Library Evolver — secrets template
#
# Copy to ~/.nuzantara-secrets.env (NOT committed) and fill in real
# values. The wrapper script `scripts/agent-library-evolver-run.sh`
# sources this file and rejects:
#   - /dev/null shortcut
#   - empty file
#   - missing DEEPSEEK_API_KEY
#
# IMPORTANT — CLAUDE.md hard rule: NEVER set ANTHROPIC_API_KEY here
# or anywhere. The wrapper REJECTS the run with exit 2 if the variable
# is set after sourcing this file (panel R5 BLOCKING #8 fix —
# previously the wrapper silently unset the key, hiding the violation
# instead of surfacing it).

# ─── DeepSeek V4 Pro API (sanctioned paid LLM endpoint) ─────────────

# Get from https://platform.deepseek.com/api_keys
# Format: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY="REPLACE_ME"

# ─── PostgreSQL (Bali Zero CRM — local Pro) ──────────────────────────

# Used for: (1) pg_try_advisory_lock single-flight guarantee in
# wrapper, (2) dynamic CRM client/company name loading in _redact_pii.py
# Optional — if unset, wrapper falls back to no-lock + no-dynamic-names
# (with warning).
DATABASE_URL="postgresql://localhost:5432/nuzantara_crm"

# ─── Telegram bot (alerts) ───────────────────────────────────────────

# @Balizerobot — Zero's notification bot, verified live 2026-04-07.
# Token from BotFather. chat_id 1125336968 is Zero's @zero0101010101010
# private chat with @Balizerobot.
TELEGRAM_BOT_TOKEN="REPLACE_ME"
TELEGRAM_OWNER_CHAT_ID="1125336968"

# ─── Budget cap (override default $1.00 prod / $0.10 smoke) ──────────

# Optional — wrapper defaults to $1.00 if unset. Set BUDGET_USD=0.10
# during smoke testing to fail-closed earlier on stuck loops.
# BUDGET_USD="1.00"
