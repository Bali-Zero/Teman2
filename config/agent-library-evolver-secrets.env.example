# Bali Zero Nuzantara agent-library-evolver — secrets template
#
# Copy this file to ~/.nuzantara-secrets.env (do NOT commit) and
# populate the values. The LaunchAgent plist sources this file at run
# time via `set -a; . "$SECRETS_FILE"; set +a` in the wrapper script.
#
# Spec: docs/superpowers/specs/2026-05-17-agent-library-evoskill-design.md

# ─── DeepSeek V4 Pro API (proposer + skill-builder + synthesis) ───
# Get from: https://platform.deepseek.com/api_keys
# Cost: ~$0.10-0.30 per weekly run. Hard cap via BUDGET_USD below.
# CLAUDE.md note: DeepSeek API is the ONLY paid LLM API allowed —
# the no-paid-API rule targets Anthropic specifically.
DEEPSEEK_API_KEY=sk-deepseek-REPLACE-ME

# ─── Telegram alert recipient ───
# Owner chat_id verified live 2026-04-07 — Zero's @zero0101010101010
# chat with @Balizerobot.
TELEGRAM_BOT_TOKEN=REPLACE-ME-from-Balizerobot-BotFather
TELEGRAM_OWNER_CHAT_ID=1125336968

# ─── Gemini 3.1 Pro free OAuth (entailment verifier) ───
# OAuth via `gemini auth login` — no API key needed in env.
# Verify token presence: `gemini --print "ping" 2>&1 | head -1`
# This var is informational only:
GEMINI_AUTH_METHOD=oauth_free_tier

# ─── Budget cap (single source of truth) ───
# Hard ceiling enforced by scripts/agent-library-evolver-run.sh
# Phase 0 smoke: 0.10 USD (no real LLM call in this phase).
# Phase 1 prod: 1.00 USD per-run, fail-closed on telemetry missing.
BUDGET_USD=1.00

# ─── Paths (defaults — override only if relocating) ───
EVOSKILL_VENDOR_DIR=/Users/nuzantara/Desktop/nuzantara/vendor/evoskill
EVOSKILL_CONFIG_PATH=/Users/nuzantara/Desktop/nuzantara/agent-library/config/evolver.toml
EVOSKILL_PROPOSALS_DIR=/Users/nuzantara/Desktop/nuzantara/agent-library/proposals
EVOSKILL_TELEMETRY_DIR=/tmp/agent-library-evolver

# ─── PG advisory lock (single-flight guarantee) ───
# psql connection used only for `SELECT pg_try_advisory_lock(...)`.
# Per CLAUDE.md: nuzantara_dev local for Pro-side cron.
PGURL=postgresql://nuzantara@localhost:5432/nuzantara_dev
EVOSKILL_LOCK_KEY=1234567890  # arbitrary stable int64 for advisory_lock
