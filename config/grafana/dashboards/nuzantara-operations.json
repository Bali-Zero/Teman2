{
  "dashboard": {
    "id": null,
    "uid": "nuzantara-ops-v1",
    "title": "Nuzantara Operations",
    "description": "Operational dashboard for Nuzantara infrastructure: services, data, pipelines, machine health",
    "tags": ["nuzantara", "operations", "production"],
    "timezone": "Asia/Makassar",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "panels": [
      {
        "type": "row",
        "title": "Services",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false,
        "panels": []
      },
      {
        "type": "stat",
        "title": "Backend Fly.io",
        "description": "nuzantara-rag.fly.dev health probe",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "probe_success{job=\"nuzantara-backend\"}",
            "legendFormat": "Backend Health",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "DOWN", "color": "red" },
                  "1": { "text": "UP", "color": "green" }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "type": "stat",
        "title": "Redis",
        "description": "Redis server status",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "redis_up{job=\"redis-exporter\"}",
            "legendFormat": "Redis",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "DOWN", "color": "red" },
                  "1": { "text": "UP", "color": "green" }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "type": "stat",
        "title": "PostgreSQL",
        "description": "PostgreSQL server status",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "pg_up{job=\"postgres-exporter\"}",
            "legendFormat": "PostgreSQL",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "DOWN", "color": "red" },
                  "1": { "text": "UP", "color": "green" }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "type": "stat",
        "title": "Prometheus",
        "description": "Prometheus self-monitoring",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "up{job=\"prometheus\"}",
            "legendFormat": "Prometheus",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "DOWN", "color": "red" },
                  "1": { "text": "UP", "color": "green" }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "type": "timeseries",
        "title": "Backend Response Latency",
        "description": "HTTP probe duration to Fly.io backend",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "probe_duration_seconds{job=\"nuzantara-backend\"}",
            "legendFormat": "Total Probe Duration",
            "refId": "A"
          },
          {
            "expr": "probe_http_duration_seconds{job=\"nuzantara-backend\",phase=\"processing\"}",
            "legendFormat": "Processing",
            "refId": "B"
          },
          {
            "expr": "probe_http_duration_seconds{job=\"nuzantara-backend\",phase=\"tls\"}",
            "legendFormat": "TLS",
            "refId": "C"
          },
          {
            "expr": "probe_http_duration_seconds{job=\"nuzantara-backend\",phase=\"connect\"}",
            "legendFormat": "Connect",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "timeseries",
        "title": "Backend Health (Up/Down Over Time)",
        "description": "Fly.io backend availability timeline",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "probe_success{job=\"nuzantara-backend\"}",
            "legendFormat": "Health (1=UP, 0=DOWN)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 40,
              "drawStyle": "bars"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "row",
        "title": "Data",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
        "collapsed": false,
        "panels": []
      },
      {
        "type": "timeseries",
        "title": "Redis Memory Usage",
        "description": "Redis used memory over time",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "redis_memory_used_bytes{job=\"redis-exporter\"}",
            "legendFormat": "Used Memory",
            "refId": "A"
          },
          {
            "expr": "redis_memory_max_bytes{job=\"redis-exporter\"}",
            "legendFormat": "Max Memory",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 15
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "stat",
        "title": "Redis Connected Clients",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 14 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "redis_connected_clients{job=\"redis-exporter\"}",
            "legendFormat": "Clients",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "red", "value": 100 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "type": "stat",
        "title": "Redis Blocked Clients",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 14 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "redis_blocked_clients{job=\"redis-exporter\"}",
            "legendFormat": "Blocked",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "type": "timeseries",
        "title": "Redis Keyspace Hit Rate",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 18 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "rate(redis_keyspace_hits_total{job=\"redis-exporter\"}[5m]) / (rate(redis_keyspace_hits_total{job=\"redis-exporter\"}[5m]) + rate(redis_keyspace_misses_total{job=\"redis-exporter\"}[5m])) * 100",
            "legendFormat": "Hit Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "palette-classic" },
            "custom": { "lineWidth": 2, "fillOpacity": 20 }
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "timeseries",
        "title": "PostgreSQL Active Connections",
        "description": "pg_stat_activity active connections",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "pg_stat_activity_count{job=\"postgres-exporter\",state=\"active\"}",
            "legendFormat": "Active",
            "refId": "A"
          },
          {
            "expr": "pg_stat_activity_count{job=\"postgres-exporter\",state=\"idle\"}",
            "legendFormat": "Idle",
            "refId": "B"
          },
          {
            "expr": "pg_stat_activity_count{job=\"postgres-exporter\",state=\"idle in transaction\"}",
            "legendFormat": "Idle in Transaction",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "stacking": { "mode": "normal" }
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "row",
        "title": "Pipelines (Cron Jobs)",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
        "collapsed": false,
        "panels": []
      },
      {
        "type": "table",
        "title": "Cron Job Status",
        "description": "Last run status for each cron job from ~/logs/cron/*.jsonl",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "cron_job_last_status",
            "legendFormat": "{{job}}",
            "refId": "A",
            "format": "table",
            "instant": true
          },
          {
            "expr": "cron_job_last_run_timestamp_seconds",
            "legendFormat": "{{job}}",
            "refId": "B",
            "format": "table",
            "instant": true
          },
          {
            "expr": "cron_job_duration_seconds",
            "legendFormat": "{{job}}",
            "refId": "C",
            "format": "table",
            "instant": true
          },
          {
            "expr": "cron_job_last_exit_code",
            "legendFormat": "{{job}}",
            "refId": "D",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Value #A" },
              "properties": [
                { "id": "displayName", "value": "Status" },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "0": { "text": "FAILED", "color": "red" },
                        "1": { "text": "OK", "color": "green" }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Value #B" },
              "properties": [
                { "id": "displayName", "value": "Last Run" },
                { "id": "unit", "value": "dateTimeFromNow" }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Value #C" },
              "properties": [
                { "id": "displayName", "value": "Duration (s)" },
                { "id": "unit", "value": "s" }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Value #D" },
              "properties": [{ "id": "displayName", "value": "Exit Code" }]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [{ "displayName": "Status", "desc": false }]
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true },
              "indexByName": {
                "job": 0,
                "Value #A": 1,
                "Value #B": 2,
                "Value #C": 3,
                "Value #D": 4
              }
            }
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Cron Job Success/Failure Over Time",
        "description": "Cumulative success and failure counts",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "cron_job_success_total",
            "legendFormat": "{{job}} success",
            "refId": "A"
          },
          {
            "expr": "cron_job_failure_total",
            "legendFormat": "{{job}} failure",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "row",
        "title": "Machine (Air - MacBook Air M4)",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
        "collapsed": false,
        "panels": []
      },
      {
        "type": "timeseries",
        "title": "CPU Usage",
        "description": "CPU utilization percentage (Docker VM)",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m])) * 100)",
            "legendFormat": "CPU Usage %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            }
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "gauge",
        "title": "RAM Usage",
        "description": "Memory utilization (Docker VM)",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})) * 100",
            "legendFormat": "RAM Used %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "orange", "value": 80 },
                { "color": "red", "value": 90 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "type": "gauge",
        "title": "Disk Usage",
        "description": "Filesystem usage (host macOS disk via Docker mount)",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/host_mnt/Users\",job=\"node-exporter\"} / node_filesystem_size_bytes{mountpoint=\"/host_mnt/Users\",job=\"node-exporter\"})) * 100",
            "legendFormat": "Disk Used %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 60 },
                { "color": "orange", "value": 75 },
                { "color": "red", "value": 80 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "type": "timeseries",
        "title": "Memory Usage Over Time",
        "description": "RAM usage trend",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes{job=\"node-exporter\"} - node_memory_MemAvailable_bytes{job=\"node-exporter\"}",
            "legendFormat": "Used",
            "refId": "A"
          },
          {
            "expr": "node_memory_MemAvailable_bytes{job=\"node-exporter\"}",
            "legendFormat": "Available",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "stacking": { "mode": "normal" }
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "type": "timeseries",
        "title": "Disk Space Available",
        "description": "Disk space over time",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "node_filesystem_avail_bytes{mountpoint=\"/host_mnt/Users\",job=\"node-exporter\"}",
            "legendFormat": "Available",
            "refId": "A"
          },
          {
            "expr": "node_filesystem_size_bytes{mountpoint=\"/host_mnt/Users\",job=\"node-exporter\"} - node_filesystem_avail_bytes{mountpoint=\"/host_mnt/Users\",job=\"node-exporter\"}",
            "legendFormat": "Used",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": { "type": "grafana", "uid": "-- Grafana --" },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    }
  },
  "overwrite": true
}
