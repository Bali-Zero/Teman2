{
  "dashboard": {
    "title": "Article Composer Dashboard",
    "tags": ["article-composer", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(article_compose_requests_total{status=\"success\"}[5m]) / rate(article_compose_requests_total[5m])",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 0.95, "color": "yellow" },
                { "value": 0.98, "color": "green" }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Request Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(article_compose_requests_total[5m]))",
            "legendFormat": "Requests/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(article_compose_requests_total{status=~\"error|api_error|json_error\"}[5m]) / rate(article_compose_requests_total[5m])",
            "legendFormat": "Error Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 0.05, "color": "yellow" },
                { "value": 0.1, "color": "red" }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
      },
      {
        "id": 4,
        "title": "Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(article_cache_hits_total[5m]) / (rate(article_cache_hits_total[5m]) + rate(article_cache_misses_total[5m]))",
            "legendFormat": "Cache Hit Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 0.2, "color": "yellow" },
                { "value": 0.3, "color": "green" }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
      },
      {
        "id": 5,
        "title": "Response Time (P50, P95, P99)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, article_compose_duration_seconds)",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, article_compose_duration_seconds)",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, article_compose_duration_seconds)",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
      },
      {
        "id": 6,
        "title": "Daily Cost",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(increase(claude_api_cost_cents[24h])) / 100",
            "legendFormat": "Daily Cost ($)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
      },
      {
        "id": 7,
        "title": "Requests by Category",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(rate(article_compose_requests_total[5m])) by (category)",
            "legendFormat": "{{category}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 }
      },
      {
        "id": 8,
        "title": "Requests by Status",
        "type": "bargauge",
        "targets": [
          {
            "expr": "sum(rate(article_compose_requests_total[5m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 }
      },
      {
        "id": 9,
        "title": "Cache Hits vs Misses",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(article_cache_hits_total[5m]))",
            "legendFormat": "Cache Hits"
          },
          {
            "expr": "sum(rate(article_cache_misses_total[5m]))",
            "legendFormat": "Cache Misses"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
